---
import Header from "../components/Header.astro";
import HeroNew from "../components/HeroNew.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import StaggeredProjects from "../components/StaggeredProjects.astro";
import DevShop from "../components/DevShop.tsx";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Certifications from "../components/Certifications.astro";
import MyApproach from "../components/MyApproach.astro";
import Marquee from "../components/Marquee.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Testimonials from "../components/Testimonials.astro";
import AntigravityBackground from "../components/AntigravityBackground";
import { siteConfig } from "../config";
import "../styles/global.css";

const ogImage = "/obaid.jpeg";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('yasio-portfolio-theme');
          if (theme && theme !== 'gold') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{siteConfig.name} | {siteConfig.title}</title>
    <meta name="description" content={siteConfig.description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="keywords" content="Shopify Hydrogen developer, Full Stack Developer, React, Next.js, TypeScript, Flutter, remote developer, freelance developer, headless commerce, Islamabad Pakistan" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteConfig.siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.siteUrl} />
    <meta property="og:title" content={`${siteConfig.name} | ${siteConfig.title}`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:image" content={`${siteConfig.siteUrl}${ogImage}`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${siteConfig.name} | ${siteConfig.title}`} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content={`${siteConfig.siteUrl}${ogImage}`} />

    <!-- Fonts and Asset CDNs -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.simpleicons.org" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- prefers-reduced-motion -->
    <style>
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <!-- ═══ CREATIVE TERMINAL BOOTLOADER (Vault Door Style) ═══ -->
    <div id="systems-bootloader" class="fixed inset-0 z-[9999] pointer-events-none">
      <!-- Top Half Panel -->
      <div id="boot-panel-top" class="absolute inset-x-0 top-0 h-1/2 bg-[#02040b] flex flex-col justify-between p-8 sm:p-12 md:p-16 border-b border-white/5 font-mono overflow-hidden pointer-events-auto transition-transform duration-[850ms] ease-[cubic-bezier(0.76,0,0.24,1)]">
        <!-- Top header -->
        <div class="flex items-center justify-between text-[10px] text-white/30 uppercase tracking-widest">
          <span>sys_build: v2.4.0</span>
          <span>utc_local: 2026-07-18</span>
        </div>

        <!-- Typing -->
        <div class="max-w-xl mx-auto w-full flex flex-col justify-end h-full pb-4">
          <div class="flex items-baseline gap-2 mb-4">
            <span class="text-2xl text-[var(--color-primary)] font-bold">//</span>
            <span id="boot-typing" class="text-lg sm:text-xl text-white font-bold tracking-tight"></span>
            <span class="w-2 h-4 bg-[var(--color-accent)] animate-pulse inline-block" style="vertical-align: middle;"></span>
          </div>

          <!-- Terminal log panel -->
          <div id="boot-terminal" class="w-full bg-[#050816]/60 border border-white/5 rounded-xl p-4 sm:p-5 h-[120px] overflow-y-auto text-[10px] sm:text-[11px] text-white/50 space-y-1.5 scrollbar-thin">
          </div>
        </div>
      </div>

      <!-- Bottom Half Panel -->
      <div id="boot-panel-bottom" class="absolute inset-x-0 bottom-0 h-1/2 bg-[#02040b] flex flex-col justify-between p-8 sm:p-12 md:p-16 font-mono overflow-hidden pointer-events-auto transition-transform duration-[850ms] ease-[cubic-bezier(0.76,0,0.24,1)]">
        <!-- Progress -->
        <div class="max-w-xl mx-auto w-full flex flex-col justify-start h-full pt-4">
          <!-- Counter Progress panel -->
          <div class="w-full flex items-center justify-between text-[10px] text-[var(--color-accent)] uppercase tracking-wider mb-2">
            <span>mounting workspace clusters...</span>
            <span id="boot-percentage" class="font-bold">00%</span>
          </div>

          <!-- Progress bar -->
          <div class="w-full h-[1px] bg-white/5 relative overflow-hidden rounded-full">
            <div id="boot-progress-bar" class="absolute left-0 top-0 bottom-0 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] w-0 transition-all duration-75"></div>
          </div>
        </div>

        <!-- Bottom metadata -->
        <div class="flex flex-wrap items-center justify-between text-[9px] text-white/20 uppercase tracking-wider gap-4">
          <span>© 2026 OBAIDULLAH ARSHAD // ALL RIGHTS RESERVED</span>
          <span>LATENCY: HYDRATED EDGE CACHE 1.08ms</span>
        </div>
      </div>
    </div>

    <!-- Global backdrop auroras -->
    <div class="global-aurora-bg">
      <div class="global-aurora-blob aurora-1"></div>
      <div class="global-aurora-blob aurora-2"></div>
      <div class="global-aurora-blob aurora-3"></div>
      <div class="global-aurora-blob aurora-4"></div>
    </div>

    <style>
      body.loaded #boot-panel-top {
        transform: translateY(-100%);
      }
      body.loaded #boot-panel-bottom {
        transform: translateY(100%);
      }
      body.loaded #systems-bootloader {
        pointer-events: none;
      }
    </style>

    <script>
      (function() {
        const typingText = document.getElementById('boot-typing');
        const progressText = document.getElementById('boot-percentage');
        const progressBar = document.getElementById('boot-progress-bar');
        const terminalLog = document.getElementById('boot-terminal');

        const logs = [
          "[sys] establishing oxygen edge worker clusters...",
          "[sys] warming storefront cdn endpoints... done",
          "[sys] mapping mern controllers & rest routes... active",
          "[sys] established shopify api nodes connection (1.08ms)",
          "[sys] established mongodb atlas cluster sync (20ms latency)",
          "[sys] cached: 24 storefront layout modules loaded",
          "[sys] active state: systems check 100% green",
          "[sys] initialization complete. booting interface..."
        ];

        let progress = 0;
        let logIdx = 0;
        
        // Typing header animation
        const headerStr = "obaidullah_arshad.init()";
        let charIdx = 0;
        function typeHeader() {
          if (!typingText) return;
          if (charIdx < headerStr.length) {
            typingText.textContent += headerStr[charIdx];
            charIdx++;
            setTimeout(typeHeader, 45);
          }
        }
        typeHeader();

        const progressInterval = setInterval(() => {
          progress += Math.floor(Math.random() * 3) + 1;
          if (progress > 100) progress = 100;
          
          if (progressText) progressText.textContent = `${String(progress).padStart(2, '0')}%`;
          if (progressBar) progressBar.style.width = `${progress}%`;

          // Append logs at specific progress thresholds
          const targetLogCount = Math.floor((progress / 100) * logs.length);
          while (logIdx < targetLogCount && logIdx < logs.length) {
            if (terminalLog) {
              const p = document.createElement('div');
              p.className = 'opacity-0 translate-y-1 transition-all duration-300';
              p.innerHTML = `<span class="text-[var(--color-primary)] font-bold">>></span> ${logs[logIdx]}`;
              terminalLog.appendChild(p);
              
              // Force layout trigger & animate entry
              p.offsetHeight;
              p.classList.remove('opacity-0', 'translate-y-1');
              terminalLog.scrollTop = terminalLog.scrollHeight;
            }
            logIdx++;
          }

          if (progress >= 100) {
            clearInterval(progressInterval);
            setTimeout(() => {
              document.body.classList.add('loaded');
              setTimeout(() => {
                const bootloader = document.getElementById('systems-bootloader');
                if (bootloader) bootloader.style.display = 'none';
              }, 900);
            }, 400);
          }
        }, 30);
      })();
    </script>
    <!-- ═════════════════════════ -->

    <!-- Masks the 24px gap above the floating fixed header so content doesn't bleed through -->
    <div aria-hidden="true" style="position:fixed;top:0;left:0;right:0;height:28px;background:linear-gradient(to bottom,#02030b 60%,transparent 100%);z-index:51;pointer-events:none;"></div>


    <!-- Scroll glow -->
    <div id="scroll-glow"></div>

    <!-- Dynamic Antigravity Particle Field Background (very subtle, dynamic colors, active throughout the site) -->
    <div id="antigravity-bg-container" class="fixed inset-0 z-[1] pointer-events-none mix-blend-screen active">
      <AntigravityBackground client:only="react" />
    </div>

    <!-- Scroll progress bar -->
    <div id="scroll-progress"></div>

    <!-- Left social sidebar (desktop only) -->
    <div id="sidebar-left" class="social-sidebar left-8">
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <div class="sidebar-line"></div>
    </div>

    <!-- Right sidebar: say hello (desktop only) -->
    <div id="sidebar-right" class="social-sidebar right-8">
      <a href="#contact" class="writing-vertical text-xs font-mono tracking-widest text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors">
        Say Hello
      </a>
      <div class="sidebar-line"></div>
    </div>

    <Header />

    <main>
      <HeroNew />
      <Marquee />
      <Services />
      <About />
      <StaggeredProjects />
      <Testimonials />
      
      <!-- Shopify Headless Storefront GraphQL Sandbox -->
      <section id="playzone" class="p-8 sm:p-12 md:p-16 lg:p-24 section-alt relative overflow-hidden">
        <!-- Visual background details (blueprint grid and glowing ambient light bubbles) -->
        <div class="absolute inset-0 hero-grid-bg opacity-[0.08] pointer-events-none select-none"></div>
        <div class="absolute top-[10%] left-[-10%] w-[600px] h-[600px] rounded-full bg-[var(--color-primary)] opacity-[0.08] blur-[140px] pointer-events-none select-none animate-gentle-pulse"></div>
        <div class="absolute bottom-[10%] right-[-10%] w-[600px] h-[600px] rounded-full bg-[var(--color-accent)] opacity-[0.08] blur-[140px] pointer-events-none select-none animate-float"></div>

        <div class="max-w-7xl mx-auto relative z-10">
          <div class="text-center mb-16 scroll-fade">
            <span class="text-[var(--color-primary)] font-mono text-sm tracking-widest uppercase mb-3 block">Developer Sandbox /</span>
            <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-[var(--color-text)] mb-4">
              GraphQL Storefront Playzone
            </h2>
            <div class="w-[60px] h-[4px] mx-auto rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] mb-5"></div>
            <p class="text-[var(--color-text-muted)] max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
              Query live storefront products and generate active checkout sessions directly on Shopify Oxygen edge nodes using Storefront API mutations.
            </p>
          </div>
          
          <!-- Sandbox Intro Panel (default view) -->
          <div id="sandbox-intro-card" class="rounded-3xl border border-white/10 bg-black/40 backdrop-blur-md p-8 text-center max-w-2xl mx-auto space-y-6 scroll-scale">
            <div class="inline-flex p-3 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"/>
              </svg>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-white">Interactive Sandbox Console</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
              Inspect dynamic GraphQL query mutations and database CRUD records. Built for technical reviewers and system architects.
            </p>
            <button id="activate-sandbox-direct-btn" class="px-6 py-3 bg-[var(--color-primary)] hover:bg-[var(--color-accent)] text-[var(--color-btn-text)] text-sm font-bold rounded-xl transition-all shadow-[0_0_20px_rgba(20,184,166,0.35)]" data-cursor-text="LAUNCH">
              Launch Developer Console Lab
            </button>
          </div>

          <!-- Hidden active sandbox -->
          <div id="sandbox-wrapper" class="hidden opacity-0 transition-opacity duration-500">
            <DevShop client:load />
          </div>
        </div>
      </section>
      <Experience />
      <Education />
      <Certifications />
      <MyApproach />
      <Contact />
    </main>

    <Footer />

    <!-- Fixed Telemetry Overlay Widget -->
    <button id="telemetry-toggle" class="fixed bottom-8 left-8 z-40 flex items-center gap-2 px-3 py-2 rounded-full font-mono text-[9px] font-bold text-white/50 border border-white/10 bg-[#050816]/70 backdrop-blur-md hover:text-[var(--color-primary)] hover:border-[var(--color-primary)]/50 transition-all duration-300" aria-label="Toggle Telemetry Panel" data-cursor-text="SYS DATA">
      <span class="relative flex h-1.5 w-1.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-400"></span>
      </span>
      SYS_MONITOR
    </button>

    <!-- Telemetry HUD Panel -->
    <div id="telemetry-panel" class="fixed bottom-24 left-8 z-40 w-[240px] font-mono text-[10px] text-white/60 bg-black/90 backdrop-blur-lg border border-white/10 rounded-xl p-4 transition-all duration-300 transform scale-90 translate-y-4 opacity-0 pointer-events-none">
      <div class="flex items-center justify-between border-b border-white/10 pb-2 mb-3">
        <span class="font-bold text-[var(--color-primary)]">SYSTEM TELEMETRY</span>
        <span class="text-[8px] bg-emerald-500/10 text-emerald-400 px-1.5 py-0.5 rounded font-bold uppercase">sys_ok</span>
      </div>
      
      <div class="space-y-2">
        <div class="flex justify-between">
          <span>RENDER ENGINE:</span>
          <span class="text-white font-bold">VITE / ASTRO</span>
        </div>
        <div class="flex justify-between">
          <span>FPS PERFORMANCE:</span>
          <span id="tel-fps" class="text-emerald-400 font-bold">-- FPS</span>
        </div>
        <div class="flex justify-between">
          <span>DOM FOOTPRINT:</span>
          <span id="tel-dom" class="text-white font-bold">-- NODES</span>
        </div>
        <div class="flex justify-between">
          <span>JS HEAP USAGE:</span>
          <span id="tel-mem" class="text-white font-bold">-- MB</span>
        </div>
        <div class="flex justify-between">
          <span>LOAD LATENCY:</span>
          <span id="tel-load" class="text-white font-bold">-- MS</span>
        </div>
        <div class="flex justify-between">
          <span>CLIENT HYDRATION:</span>
          <span class="text-[var(--color-accent)] font-bold">REACT READY</span>
        </div>
      </div>
    </div>

    <!-- Back to top button -->
    <button id="back-to-top" aria-label="Back to top">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    <style>
      #vfx-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 9990;
      }
      
      /* Lenis smooth scrolling base styles */
      html.lenis {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto;
      }
      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }
      .lenis.lenis-scrolling iframe {
        pointer-events: none;
      }
    </style>

    <script>
      import Lenis from '@studio-freight/lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });

      lenis.on('scroll', ScrollTrigger.update);

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      setTimeout(() => {
        ScrollTrigger.refresh();
      }, 500);

      // ===== OPT-IN SANDBOX ACTIVATION =====
      (function () {
        const intro = document.getElementById('sandbox-intro-card');
        const wrapper = document.getElementById('sandbox-wrapper');
        const launchBtn = document.getElementById('activate-sandbox-direct-btn');
        if (!intro || !wrapper || !launchBtn) return;

        const activateSandbox = () => {
          intro.classList.add('hidden');
          wrapper.classList.remove('hidden');
          setTimeout(() => {
            wrapper.classList.add('opacity-100');
            ScrollTrigger.refresh();
          }, 50);
        };

        launchBtn.addEventListener('click', activateSandbox);
      })();


      // ===== SCROLL GLOW =====
      (function () {
        const sg = document.getElementById('scroll-glow');
        if (!sg) return;
        sg.classList.add('active');

        let scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        window.addEventListener('resize', () => {
          scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        });

        const update = () => {
          const p = scrollHeight > 0 ? window.scrollY / scrollHeight : 0;
          sg.style.opacity = String(Math.min(0.5, 0.06 + p * 0.7).toFixed(3));
          sg.style.backgroundPosition = `50% ${Math.min(60, p * 120)}%`;
          sg.style.transform = `translate3d(0, ${window.scrollY * 0.35}px, 0)`;
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      })();

      // ===== NATIVE INTERSECTION OBSERVER FOR SCROLL REVEALS =====
      (function () {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              obs.unobserve(e.target); // Trigger once
            }
          });
        }, {
          rootMargin: '0px 0px -8% 0px', // Trigger slightly before entering viewport
          threshold: 0.04
        });

        // Query all elements configured with CSS scroll reveals
        const targets = document.querySelectorAll(
          '.scroll-fade, .scroll-slide-left, .scroll-slide-right, .scroll-scale, .scroll-stagger, .clip-reveal, .accent-bar, .block-reveal'
        );
        targets.forEach(t => {
          // Temporarily hide elements via JS before they are observed to avoid flash of visible content.
          // The CSS handles the fallback if JS is disabled.
          if (!t.classList.contains('scroll-stagger') && !t.classList.contains('block-reveal')) {
            t.style.opacity = '0';
          }
          obs.observe(t);
        });
      })();




      // ===== MAGNETIC BUTTONS =====
      (function () {
        document.querySelectorAll('.magnetic').forEach(btn => {
          let r = btn.getBoundingClientRect();
          btn.addEventListener('mouseenter', () => {
            r = btn.getBoundingClientRect();
          });
          btn.addEventListener('mousemove', (e) => {
            const x = ((e as MouseEvent).clientX - r.left - r.width  / 2) * 0.35;
            const y = ((e as MouseEvent).clientY - r.top  - r.height / 2) * 0.35;
            (btn as HTMLElement).style.transform = `translate3d(${x}px, ${y}px, 0)`;
          });
          btn.addEventListener('mouseleave', () => {
            (btn as HTMLElement).style.transform = '';
          });
        });
      })();

      // ===== FLOATING SIDEBARS (fade in immediately) =====
      (function () {
        setTimeout(() => {
          document.getElementById('sidebar-left')?.classList.add('visible');
          document.getElementById('sidebar-right')?.classList.add('visible');
        }, 100);
      })();

      // ===== BACK TO TOP =====
      (function () {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        let visible = false;
        const agBg = document.getElementById('antigravity-bg-container');
        const updateScrollStates = () => {
          const isOverLimit = (window.scrollY || document.documentElement.scrollTop) > 400;
          if (isOverLimit !== visible) {
            visible = isOverLimit;
            btn.classList.toggle('visible', visible);
          }
        };
        window.addEventListener('scroll', updateScrollStates, { passive: true });
        updateScrollStates(); // Run immediately on mount
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();

      // ===== TEXT SCRAMBLE ON SECTION H2 =====
      (function () {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%';
        function scramble(el) {
          const original = el.dataset.original ?? el.textContent ?? '';
          if (!el.dataset.original) el.dataset.original = original;
          let frame = 0;
          const totalFrames = 18;
          const id = setInterval(() => {
            el.textContent = original.split('').map((ch, i) => {
              if (ch === ' ') return ' ';
              if (i < Math.floor((frame / totalFrames) * original.length)) return ch;
              return chars[Math.floor(Math.random() * chars.length)];
            }).join('');
            frame++;
            if (frame > totalFrames) {
              el.textContent = original;
              clearInterval(id);
            }
          }, 35);
        }

        const obs = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              scramble(e.target);
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.5 });

        document.querySelectorAll('section h2').forEach(h2 => obs.observe(h2));
      })();
    </script>

    <!-- System Telemetry Script -->
    <script>
      (function () {
        const toggle = document.getElementById('telemetry-toggle');
        const panel = document.getElementById('telemetry-panel');
        if (!toggle || !panel) return;

        toggle.addEventListener('click', () => {
          const isClosed = panel.classList.contains('pointer-events-none');
          if (isClosed) {
            panel.classList.remove('pointer-events-none', 'opacity-0', 'scale-90', 'translate-y-4');
            panel.classList.add('opacity-100', 'scale-100', 'translate-y-0');
            toggle.classList.add('text-[var(--color-primary)]', 'border-[var(--color-primary)]/40', 'bg-[var(--color-primary)]/[0.04]', 'shadow-[0_0_15px_rgba(223,193,93,0.25)]');
          } else {
            panel.classList.add('pointer-events-none', 'opacity-0', 'scale-90', 'translate-y-4');
            panel.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
            toggle.classList.remove('text-[var(--color-primary)]', 'border-[var(--color-primary)]/40', 'bg-[var(--color-primary)]/[0.04]', 'shadow-[0_0_15px_rgba(223,193,93,0.25)]');
          }
        });

        // 1. DOM counter
        const domEl = document.getElementById('tel-dom');
        if (domEl) {
          const updateDOM = () => {
            domEl.textContent = String(document.getElementsByTagName('*').length);
          };
          updateDOM();
          setInterval(updateDOM, 4000);
        }

        // 2. Load latency
        const loadEl = document.getElementById('tel-load');
        if (loadEl) {
          const getLoadTime = () => {
            const [navigation] = performance.getEntriesByType('navigation') as any[];
            if (navigation) {
              loadEl.textContent = `${Math.round(navigation.duration)}ms`;
            } else if (performance.timing) {
              const t = performance.timing;
              const duration = t.loadEventEnd - t.navigationStart;
              loadEl.textContent = `${Math.max(0, duration)}ms`;
            }
          };
          
          if (document.readyState === 'complete') {
            getLoadTime();
          } else {
            window.addEventListener('load', () => setTimeout(getLoadTime, 100));
          }
        }

        // 3. Memory usage
        const memEl = document.getElementById('tel-mem');
        if (memEl) {
          const updateMem = () => {
            const perf = window.performance as any;
            if (perf && perf.memory) {
              memEl.textContent = `${Math.round(perf.memory.usedJSHeapSize / 1048576)}MB`;
            } else {
              memEl.textContent = 'N/A';
            }
          };
          updateMem();
          setInterval(updateMem, 5000);
        }

        // 4. FPS Performance
        const fpsEl = document.getElementById('tel-fps');
        if (fpsEl) {
          let frames = 0;
          let lastTime = performance.now();
          function fpsTick() {
            frames++;
            const now = performance.now();
            if (now >= lastTime + 1000) {
              const fps = Math.round((frames * 1000) / (now - lastTime));
              fpsEl.textContent = `${fps} FPS`;
              
              if (fps >= 55) {
                fpsEl.className = 'text-emerald-400 font-bold';
              } else if (fps >= 40) {
                fpsEl.className = 'text-amber-400 font-bold';
              } else {
                fpsEl.className = 'text-rose-400 font-bold';
              }
              frames = 0;
              lastTime = now;
            }
            requestAnimationFrame(fpsTick);
          }
          requestAnimationFrame(fpsTick);
        }
      })();
    </script>

  </body>
</html>
