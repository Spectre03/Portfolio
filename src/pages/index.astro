---
import Header from "../components/Header.astro";
import HeroNew from "../components/HeroNew.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Certifications from "../components/Certifications.astro";
import MyApproach from "../components/MyApproach.astro";
import Marquee from "../components/Marquee.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const ogImage = "/obaid.jpeg";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{siteConfig.name} | {siteConfig.title}</title>
    <meta name="description" content={siteConfig.description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="keywords" content="Shopify Hydrogen developer, Full Stack Developer, React, Next.js, TypeScript, Flutter, remote developer, freelance developer, headless commerce, Islamabad Pakistan" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteConfig.siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.siteUrl} />
    <meta property="og:title" content={`${siteConfig.name} | ${siteConfig.title}`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:image" content={`${siteConfig.siteUrl}${ogImage}`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${siteConfig.name} | ${siteConfig.title}`} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content={`${siteConfig.siteUrl}${ogImage}`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- prefers-reduced-motion -->
    <style>
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>

    <!-- Masks the 24px gap above the floating fixed header so content doesn't bleed through -->
    <div aria-hidden="true" style="position:fixed;top:0;left:0;right:0;height:28px;background:linear-gradient(to bottom,#070921 55%,transparent 100%);z-index:51;pointer-events:none;"></div>

    <!-- ═══════════════════════════════════════
         SITE INTRO — dramatic curtain reveal
    ═══════════════════════════════════════ -->
    <div id="site-intro">
      <div id="intro-panel-top"></div>
      <div id="intro-panel-bot"></div>
      <div id="intro-glow-orb"></div>
      <div id="intro-seam"></div>
      <div id="intro-flash"></div>
      <div id="intro-stage">
        <div id="intro-eyebrow">— Welcome —</div>
        <div id="intro-name" aria-label="Obaidullah Arshad">&#8203;</div>
        <div id="intro-line"></div>
        <div id="intro-sub">Full Stack Developer &amp; Builder</div>
      </div>
      <span id="intro-skip">tap to skip</span>
    </div>

    <style>
      #site-intro {
        position: fixed;
        inset: 0;
        z-index: 9999;
        overflow: hidden;
        cursor: pointer;
      }

      /* ── Curtain panels ── */
      #intro-panel-top,
      #intro-panel-bot {
        position: absolute;
        left: 0; right: 0;
        height: 51%;
        background: #030714;
        will-change: transform;
      }
      #intro-panel-top {
        top: 0;
        background-image:
          linear-gradient(rgba(124,58,237,0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgba(124,58,237,0.07) 1px, transparent 1px),
          radial-gradient(ellipse 80% 60% at 50% 100%, rgba(124,58,237,0.12) 0%, transparent 70%),
          linear-gradient(#030714, #070921);
        background-size: 48px 48px, 48px 48px, 100% 100%, 100% 100%;
      }
      #intro-panel-bot {
        bottom: 0;
        background-image:
          linear-gradient(rgba(124,58,237,0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgba(124,58,237,0.07) 1px, transparent 1px),
          radial-gradient(ellipse 80% 60% at 50% 0%, rgba(6,182,212,0.10) 0%, transparent 70%),
          linear-gradient(#070921, #030714);
        background-size: 48px 48px, 48px 48px, 100% 100%, 100% 100%;
      }

      /* ── Central breathing glow ── */
      #intro-glow-orb {
        position: absolute;
        width: 700px; height: 700px;
        border-radius: 50%;
        left: 50%; top: 50%;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle,
          rgba(124,58,237,0.18) 0%,
          rgba(6,182,212,0.07) 40%,
          transparent 68%
        );
        z-index: 2;
        animation: orb-breathe 2.4s ease-in-out infinite;
        pointer-events: none;
      }
      @keyframes orb-breathe {
        0%, 100% { transform: translate(-50%,-50%) scale(0.88); opacity: 0.7; }
        50%       { transform: translate(-50%,-50%) scale(1.12); opacity: 1;   }
      }

      /* ── Seam line ── */
      #intro-seam {
        position: absolute;
        left: 0; right: 0;
        top: 50%;
        height: 1px;
        transform: translateY(-0.5px);
        z-index: 6;
        background: linear-gradient(90deg,
          transparent 0%,
          rgba(124,58,237,0.95) 20%,
          rgba(6,182,212,1) 50%,
          rgba(124,58,237,0.95) 80%,
          transparent 100%
        );
        box-shadow:
          0 0 8px  rgba(124,58,237,0.9),
          0 0 24px rgba(124,58,237,0.6),
          0 0 60px rgba(6,182,212,0.4),
          0 0 120px rgba(124,58,237,0.2);
        animation: seam-pulse 2s ease-in-out infinite;
        transition: opacity 0.12s ease, box-shadow 0.12s ease;
      }
      #site-intro.flash-exit #intro-seam {
        box-shadow:
          0 0 20px  rgba(255,255,255,0.9),
          0 0 80px  rgba(124,58,237,1),
          0 0 200px rgba(6,182,212,0.8);
        background: linear-gradient(90deg, transparent, white 30%, white 70%, transparent);
      }
      #site-intro.exit #intro-seam { opacity: 0; }
      @keyframes seam-pulse {
        0%,100% { opacity: 0.75; }
        50%     { opacity: 1; }
      }

      /* ── Flash overlay ── */
      #intro-flash {
        position: absolute;
        inset: 0;
        background: white;
        opacity: 0;
        z-index: 15;
        pointer-events: none;
        transition: opacity 0.08s ease;
      }
      #site-intro.flash-exit #intro-flash { opacity: 0.25; }

      /* ── Stage ── */
      #intro-stage {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        z-index: 10;
        pointer-events: none;
      }

      /* Eyebrow */
      #intro-eyebrow {
        font-size: clamp(0.65rem, 1.8vw, 0.8rem);
        font-family: monospace;
        letter-spacing: 0.22em;
        color: rgba(167,139,250,0.7);
        text-transform: uppercase;
        opacity: 0;
        transform: translateY(8px);
      }

      /* Name */
      #intro-name {
        font-size: clamp(2.2rem, 9vw, 6.5rem);
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1;
        text-align: center;
        padding: 0 1rem;
        background: linear-gradient(135deg, #ffffff 0%, #c4b5fd 35%, #06b6d4 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 60px rgba(124,58,237,0.6)) drop-shadow(0 0 20px rgba(6,182,212,0.3));
        min-height: 1.1em;
      }

      /* Gradient bar */
      #intro-line {
        height: 2px;
        width: 0;
        border-radius: 99px;
        background: linear-gradient(90deg, #7c3aed, #06b6d4, #7c3aed);
        background-size: 200% 100%;
        box-shadow: 0 0 20px rgba(124,58,237,0.7), 0 0 40px rgba(6,182,212,0.4);
        animation: bar-shimmer 2s linear infinite;
      }
      @keyframes bar-shimmer {
        0%   { background-position: 0% 0%; }
        100% { background-position: 200% 0%; }
      }

      /* Subtitle */
      #intro-sub {
        font-size: clamp(0.68rem, 2vw, 0.9rem);
        font-weight: 500;
        color: rgba(152,160,180,0.8);
        letter-spacing: 0.1em;
        text-align: center;
        padding: 0 1.5rem;
        opacity: 0;
        transform: translateY(6px);
      }

      /* Skip */
      #intro-skip {
        position: absolute;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.6rem;
        color: rgba(152,160,180,0.25);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        z-index: 20;
        pointer-events: none;
        font-family: monospace;
        white-space: nowrap;
      }
    </style>

    <script>
      (function () {
        var intro    = document.getElementById('site-intro');
        var nameEl   = document.getElementById('intro-name');
        var lineEl   = document.getElementById('intro-line');
        var subEl    = document.getElementById('intro-sub');
        var eyebrow  = document.getElementById('intro-eyebrow');
        var panelTop = document.getElementById('intro-panel-top');
        var panelBot = document.getElementById('intro-panel-bot');
        var seamEl   = document.getElementById('intro-seam');
        var flashEl  = document.getElementById('intro-flash');
        var stageEl  = document.getElementById('intro-stage');
        if (!intro || !nameEl) return;

        document.body.style.overflow = 'hidden';

        /* ── Easing helpers ── */
        function easeOut3(p) { return 1 - Math.pow(1 - p, 3); }
        function easeIn3(p)  { return p * p * p; }

        /* Animate a single numeric property from a→b over duration ms */
        function tween(duration, onUpdate, onDone) {
          var start = null;
          function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts - start) / duration, 1);
            onUpdate(p);
            if (p < 1) requestAnimationFrame(step);
            else if (onDone) onDone();
          }
          requestAnimationFrame(step);
        }

        /* ── Show eyebrow: fade + slide up ── */
        function showEyebrow() {
          tween(450, function(p) {
            var e = easeOut3(p);
            eyebrow.style.opacity = String(e);
            eyebrow.style.transform = 'translateY(' + (8 * (1 - e)) + 'px)';
          });
        }

        /* ── Text scramble for name (time-based, not frame-count-based) ── */
        var FINAL = 'Obaidullah Arshad';
        var CHARS = '!<>_\\/[]{}=+*^?#@~ABCDEFabcdef0123456789';
        var SCRAMBLE_DURATION = 1100; /* ms — same wall-clock time on any refresh rate */
        var scrambleStart = null;
        var scrambleDone = false;
        var scrambleRaf = 0;

        function scrambleTick(ts) {
          if (!scrambleStart) scrambleStart = ts;
          var p = Math.min((ts - scrambleStart) / SCRAMBLE_DURATION, 1);
          var resolved = Math.floor(p * FINAL.length);
          nameEl.textContent = FINAL.split('').map(function(ch, i) {
            if (ch === ' ') return ' ';
            if (i < resolved) return ch;
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          }).join('');
          if (p < 1) {
            scrambleRaf = requestAnimationFrame(scrambleTick);
          } else {
            nameEl.textContent = FINAL;
            scrambleDone = true;
            /* after scramble: grow bar, fade sub, then auto-exit */
            setTimeout(showLine, 100);
            setTimeout(showSub,  380);
            setTimeout(exit, 2000); /* auto-exit 2s after name resolves */
          }
        }

        /* ── Grow the gradient bar ── */
        var maxLineW = Math.min(320, window.innerWidth * 0.65);
        function showLine() {
          tween(600, function(p) {
            lineEl.style.width = (maxLineW * easeOut3(p)) + 'px';
          });
        }

        /* ── Fade + slide sub text ── */
        function showSub() {
          tween(450, function(p) {
            var e = easeOut3(p);
            subEl.style.opacity = String(e);
            subEl.style.transform = 'translateY(' + (6 * (1 - e)) + 'px)';
          });
        }

        /* ── Fade out stage ── */
        function fadeStage(onDone) {
          var startOp = parseFloat(stageEl.style.opacity) || 1;
          tween(280, function(p) {
            stageEl.style.opacity = String(startOp * (1 - p));
          }, onDone);
        }

        /* ── Slam panels out ── */
        function slamPanels() {
          tween(520, function(p) {
            var e = easeIn3(p);
            if (panelTop) panelTop.style.transform = 'translateY(' + (-102 * e) + '%)';
            if (panelBot) panelBot.style.transform = 'translateY(' + ( 102 * e) + '%)';
            if (seamEl)   seamEl.style.opacity      = String(1 - p);
          }, function() {
            intro.style.display = 'none';
          });
        }

        /* ── Full exit sequence ── */
        var done = false;
        function exit() {
          if (done) return;
          done = true;
          cancelAnimationFrame(scrambleRaf);
          /* Always show completed name even if exit was triggered mid-scramble */
          nameEl.textContent = FINAL;
          document.body.style.removeProperty('overflow');
          document.documentElement.style.removeProperty('overflow');

          /* flash */
          if (flashEl) {
            flashEl.style.opacity = '0.3';
            setTimeout(function() { flashEl.style.opacity = '0'; }, 120);
          }
          if (seamEl) {
            seamEl.style.background = 'linear-gradient(90deg,transparent,white 30%,white 70%,transparent)';
            seamEl.style.boxShadow  = '0 0 20px #fff,0 0 80px #7c3aed,0 0 200px #06b6d4';
          }

          fadeStage(function() {
            setTimeout(slamPanels, 60);
          });
        }

        /* Click to skip — ignore first 900ms to avoid spurious page-load events */
        var startTime = Date.now();
        intro.addEventListener('click', function() {
          if (Date.now() - startTime < 900) return;
          exit();
        });
        /* Escape to skip — added after 900ms, only Escape key */
        setTimeout(function() {
          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') exit();
          }, { once: true });
        }, 900);

        /* ── Kick off sequence ── */
        setTimeout(showEyebrow, 150);
        /* Pass RAF timestamp to scrambleTick so it's time-based */
        setTimeout(function() { scrambleRaf = requestAnimationFrame(scrambleTick); }, 430);
        /* Safety fallback — exits if scramble never completes for some reason */
        setTimeout(exit, 6000);
      })();
    </script>

    <!-- Custom cursor -->
    <div id="cursor"></div>
    <div id="cursor-outline"></div>

    <!-- Mouse tracking glow -->
    <div id="mouse-glow"></div>
    <!-- Scroll glow -->
    <div id="scroll-glow"></div>
    <!-- Scroll progress bar -->
    <div id="scroll-progress"></div>

    <!-- Left social sidebar (desktop only) -->
    <div id="sidebar-left" class="social-sidebar left-8">
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <div class="sidebar-line"></div>
    </div>

    <!-- Right sidebar: say hello (desktop only) -->
    <div id="sidebar-right" class="social-sidebar right-8">
      <a href="#contact" class="writing-vertical text-xs font-mono tracking-widest text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors">
        Say Hello
      </a>
      <div class="sidebar-line"></div>
    </div>

    <Header />

    <main>
      <HeroNew />
      <Marquee />
      <Services />
      <About />
      <Projects />
      <Experience />
      <Education />
      <Certifications />
      <MyApproach />
      <Contact />
    </main>

    <Footer />

    <!-- Back to top button -->
    <button id="back-to-top" aria-label="Back to top">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    <script>
      // ===== SCROLL PROGRESS BAR =====
      (function () {
        const progressBar = document.getElementById('scroll-progress');
        if (!progressBar) return;
        const update = () => {
          const h = document.documentElement.scrollHeight - window.innerHeight;
          progressBar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();

      // ===== MOUSE TRACKING GLOW =====
      (function () {
        const glow = document.getElementById('mouse-glow');
        if (!glow) return;
        let timeout: ReturnType<typeof setTimeout> | null = null;
        window.addEventListener('mousemove', (e: MouseEvent) => {
          glow.style.left = (e.clientX - 200) + 'px';
          glow.style.top = (e.clientY - 200) + 'px';
          glow.classList.add('active');
          if (timeout) clearTimeout(timeout);
          timeout = setTimeout(() => glow.classList.remove('active'), 2500);
        }, { passive: true });
        document.addEventListener('mouseleave', () => glow.classList.remove('active'), { passive: true });
      })();

      // ===== SCROLL GLOW =====
      (function () {
        const sg = document.getElementById('scroll-glow');
        if (!sg) return;
        sg.classList.add('active');
        const update = () => {
          const h = document.documentElement.scrollHeight - window.innerHeight;
          const p = h > 0 ? window.scrollY / h : 0;
          sg.style.opacity = String(Math.min(0.5, 0.06 + p * 0.7).toFixed(3));
          sg.style.backgroundPosition = `50% ${Math.min(60, p * 120)}%`;
          sg.style.top = (window.scrollY * 0.35) + 'px';
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      })();

      // ===== INTERSECTION OBSERVER ANIMATIONS =====
      (function () {
        const isMobile = window.innerWidth < 768;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('visible', entry.isIntersecting);
          });
        }, { threshold: [0, 0.05], rootMargin: isMobile ? '0px 0px -20px 0px' : '0px 0px -60px 0px' });

        document.querySelectorAll('.scroll-fade, .scroll-slide-left, .scroll-slide-right, .scroll-scale, .scroll-stagger, .accent-bar, .clip-reveal')
          .forEach((el) => observer.observe(el));
      })();

      // ===== TAP RIPPLE (mobile touch only — Web Animations API for reliability) =====
      (function () {
        document.addEventListener('touchstart', (e: TouchEvent) => {
          const touch = e.touches[0];
          if (!touch) return;
          const ripple = document.createElement('div');
          ripple.style.cssText = [
            'position:fixed',
            `left:${touch.clientX}px`,
            `top:${touch.clientY}px`,
            'width:10px',
            'height:10px',
            'border-radius:50%',
            'pointer-events:none',
            'z-index:9999',
            'background:radial-gradient(circle,rgba(124,58,237,0.9) 0%,rgba(6,182,212,0.5) 60%,transparent 100%)',
            'box-shadow:0 0 16px rgba(124,58,237,0.8)',
          ].join(';');
          document.body.appendChild(ripple);
          const anim = ripple.animate([
            { transform: 'translate(-50%,-50%) scale(0)', opacity: 1 },
            { transform: 'translate(-50%,-50%) scale(16)', opacity: 0 },
          ], { duration: 550, easing: 'cubic-bezier(0,0,0.2,1)', fill: 'forwards' });
          anim.onfinish = () => ripple.remove();
        }, { passive: true });
      })();

      // ===== CURSOR TRAIL =====
      (function () {
        if (window.matchMedia('(hover: none), (pointer: coarse)').matches) return;
        const TRAIL_COUNT = 10;
        const dots: HTMLElement[] = [];
        let mx = -200, my = -200;
        const positions: {x: number; y: number}[] = Array.from({length: TRAIL_COUNT}, () => ({x: -200, y: -200}));

        for (let i = 0; i < TRAIL_COUNT; i++) {
          const d = document.createElement('div');
          d.className = 'cursor-trail-dot';
          const scale = 1 - i * 0.07;
          const opacity = 1 - i * 0.09;
          d.style.cssText = `width:${6 * scale}px;height:${6 * scale}px;opacity:${opacity};transition:opacity 0.1s ease;`;
          document.body.appendChild(d);
          dots.push(d);
        }

        window.addEventListener('mousemove', (e: MouseEvent) => { mx = e.clientX; my = e.clientY; }, { passive: true });

        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
        let frame = 0;
        const tick = () => {
          positions[0].x = lerp(positions[0].x, mx, 0.35);
          positions[0].y = lerp(positions[0].y, my, 0.35);
          for (let i = 1; i < TRAIL_COUNT; i++) {
            positions[i].x = lerp(positions[i].x, positions[i-1].x, 0.5);
            positions[i].y = lerp(positions[i].y, positions[i-1].y, 0.5);
          }
          for (let i = 0; i < TRAIL_COUNT; i++) {
            dots[i].style.left = positions[i].x + 'px';
            dots[i].style.top  = positions[i].y + 'px';
          }
          // Alternate colors purple/cyan
          if (frame % 3 === 0) {
            const color = Math.random() > 0.5 ? '#7c3aed' : '#06b6d4';
            dots[0].style.background = color;
            dots[0].style.boxShadow = `0 0 8px ${color}`;
          }
          frame++;
          requestAnimationFrame(tick);
        };
        tick();

        document.addEventListener('mouseleave', () => dots.forEach(d => d.style.opacity = '0'));
        document.addEventListener('mouseenter', () => {
          dots.forEach((d, i) => d.style.opacity = String(1 - i * 0.09));
        });
      })();

      // ===== CUSTOM CURSOR =====
      (function () {
        const cursor = document.getElementById('cursor');
        const outline = document.getElementById('cursor-outline');
        if (!cursor || !outline) return;

        let mx = -100, my = -100;
        let ox = -100, oy = -100;
        let raf: number;

        window.addEventListener('mousemove', (e: MouseEvent) => {
          mx = e.clientX; my = e.clientY;
          cursor.style.left = mx + 'px';
          cursor.style.top  = my + 'px';
        }, { passive: true });

        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
        const tick = () => {
          ox = lerp(ox, mx, 0.12);
          oy = lerp(oy, my, 0.12);
          outline.style.left = ox + 'px';
          outline.style.top  = oy + 'px';
          raf = requestAnimationFrame(tick);
        };
        tick();

        // Hover state on interactive elements
        const hoverEls = document.querySelectorAll('a, button, [data-nav], .tilt-card, input, textarea, select');
        hoverEls.forEach(el => {
          el.addEventListener('mouseenter', () => {
            cursor.classList.add('hovering');
            outline.classList.add('hovering');
          });
          el.addEventListener('mouseleave', () => {
            cursor.classList.remove('hovering');
            outline.classList.remove('hovering');
          });
        });

        window.addEventListener('mousedown', () => {
          cursor.classList.add('clicking');
          outline.classList.add('clicking');
        });
        window.addEventListener('mouseup', () => {
          cursor.classList.remove('clicking');
          outline.classList.remove('clicking');
        });

        document.addEventListener('mouseleave', () => {
          cursor.style.opacity = '0';
          outline.style.opacity = '0';
        });
        document.addEventListener('mouseenter', () => {
          cursor.style.opacity = '1';
          outline.style.opacity = '1';
        });
      })();

      // ===== HERO NAME WORD REVEAL (word-safe) =====
      (function () {
        if (window.innerWidth < 768) return;
        const nameEl = document.getElementById('hero-name');
        if (!nameEl) return;
        const words = (nameEl.textContent ?? '').trim().split(' ');
        nameEl.style.opacity = '1';
        nameEl.innerHTML = words.map((word, wi) => {
          const chars = word.split('').map((ch, ci) => {
            const delay = 0.12 + (wi * word.length + ci) * 0.04;
            return `<span class="char-reveal" style="animation-delay:${delay}s">${ch}</span>`;
          }).join('');
          return `<span style="display:inline-block;white-space:nowrap">${chars}</span>`;
        }).join('<span style="display:inline-block;min-width:0.3em"> </span>');
      })();

      // ===== MAGNETIC BUTTONS =====
      (function () {
        document.querySelectorAll<HTMLElement>('.magnetic').forEach(btn => {
          btn.addEventListener('mousemove', (e: MouseEvent) => {
            const r = btn.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width  / 2) * 0.35;
            const y = (e.clientY - r.top  - r.height / 2) * 0.35;
            btn.style.transform = `translate(${x}px, ${y}px)`;
          });
          btn.addEventListener('mouseleave', () => {
            btn.style.transform = '';
          });
        });
      })();

      // ===== FLOATING SIDEBARS (fade in after 1.4s) =====
      (function () {
        setTimeout(() => {
          document.getElementById('sidebar-left')?.classList.add('visible');
          document.getElementById('sidebar-right')?.classList.add('visible');
        }, 1400);
      })();

      // ===== BACK TO TOP =====
      (function () {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        window.addEventListener('scroll', () => {
          btn.classList.toggle('visible', window.scrollY > 400);
        }, { passive: true });
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();

      // ===== TEXT SCRAMBLE ON SECTION H2 =====
      (function () {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%';
        function scramble(el: HTMLElement) {
          const original = el.dataset.original ?? el.textContent ?? '';
          if (!el.dataset.original) el.dataset.original = original;
          let frame = 0;
          const totalFrames = 18;
          const id = setInterval(() => {
            el.textContent = original.split('').map((ch, i) => {
              if (ch === ' ') return ' ';
              if (i < Math.floor((frame / totalFrames) * original.length)) return ch;
              return chars[Math.floor(Math.random() * chars.length)];
            }).join('');
            frame++;
            if (frame > totalFrames) {
              el.textContent = original;
              clearInterval(id);
            }
          }, 35);
        }

        const obs = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              scramble(e.target as HTMLElement);
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.5 });

        document.querySelectorAll<HTMLElement>('section h2').forEach(h2 => obs.observe(h2));
      })();
    </script>
  </body>
</html>
