---
import { siteConfig } from "../config";
import DevShop from "./DevShop";
const featured = (siteConfig.projects as any[]).filter(p => p.featured);
const regular  = (siteConfig.projects as any[]).filter(p => !p.featured);
---

<section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24 section-alt">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-16">
      <div class="lg:col-span-6 scroll-slide-left">
        <h2 class="clip-reveal text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-[var(--color-text)]">
          Case Studies
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] accent-bar"></div>
      </div>
      <div class="lg:col-span-6 scroll-fade">
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          High-performance Shopify storefronts and custom full-stack solutions. Built for maximum speed, dynamic conversions, and clean developer architectures.
        </p>
      </div>
    </div>

    <!-- ═══ BENTO GRID CASE STUDIES ═══ -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[minmax(240px,_auto)] scroll-stagger" id="bento-grid">
      
      <!-- BENTO CARD 1: Crestline Storefront (Large, 2-Col x 2-Row) -->
      <div class="md:col-span-2 row-span-2 spotlight-card tilt-card group relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--glass-bg)] p-6 sm:p-8 flex flex-col justify-between hover:shadow-[0_0_80px_rgba(223, 193, 93,0.18)] transition-all duration-500">
        <!-- Accent Glow background -->
        <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 via-teal-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        
        <div>
          <!-- Card top bar -->
          <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider">
              ★ Featured Headless Store
            </span>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono text-[var(--color-text-muted)]">Remix + Hydrogen</span>
              <span class="text-[10px] font-bold text-white/60 bg-white/10 rounded px-2.5 py-0.5">Private</span>
            </div>
          </div>

          <!-- Project Description -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
            <div>
              <h3 class="text-2xl sm:text-3xl font-black text-[var(--color-text)] mb-3 group-hover:text-emerald-400 transition-colors duration-300">
                Crestline Storefront
              </h3>
              <p class="text-[var(--color-text-muted)] text-sm sm:text-base leading-relaxed mb-6">
                A custom Shopify Hydrogen storefront built using headless commerce architecture. Engineered dynamic cart sync and collection search queries using the Shopify Storefront API to reduce payload sizes and drop load times by 40%.
              </p>
              
              <!-- Lighthouse Speed Badges -->
              <div class="flex gap-4 mb-4">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full border-2 border-emerald-500 flex items-center justify-center text-xs font-bold text-emerald-400 bg-emerald-500/5 shadow-[0_0_12px_rgba(16,185,129,0.3)]">98</div>
                  <span class="text-[9px] uppercase font-mono text-[var(--color-text-muted)] mt-1.5">Speed</span>
                </div>
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full border-2 border-emerald-500 flex items-center justify-center text-xs font-bold text-emerald-400 bg-emerald-500/5 shadow-[0_0_12px_rgba(16,185,129,0.3)]">100</div>
                  <span class="text-[9px] uppercase font-mono text-[var(--color-text-muted)] mt-1.5">SEO</span>
                </div>
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full border-2 border-emerald-500 flex items-center justify-center text-xs font-bold text-emerald-400 bg-emerald-500/5 shadow-[0_0_12px_rgba(16,185,129,0.3)]">96</div>
                  <span class="text-[9px] uppercase font-mono text-[var(--color-text-muted)] mt-1.5">UX</span>
                </div>
              </div>
            </div>

            <!-- Code query mock drawer -->
            <div class="rounded-xl border border-white/5 bg-black/40 overflow-hidden font-mono text-[10px] leading-relaxed relative max-h-[220px] lg:max-h-none overflow-y-auto">
              <div class="flex items-center justify-between px-3.5 py-2 bg-white/[0.03] border-b border-white/5">
                <span class="text-[9px] text-white/40">storefrontQuery.graphql</span>
                <span class="text-[9px] text-emerald-400 font-bold uppercase">GraphQL API</span>
              </div>
              <pre class="p-3.5 text-white/70 overflow-x-auto"><code>{`query getProduct($handle: String!) {
  product(handle: $handle) {
    id
    title
    descriptionHtml
    variants(first: 5) {
      edges {
        node {
          id
          title
          price {
            amount
            currencyCode
          }
        }
      }
    }
  }
}`}</code></pre>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mt-8 pt-4 border-t border-white/5">
          {siteConfig.projects[0].skills.map((skill) => (
            <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold border border-emerald-500/20 bg-emerald-500/5 text-emerald-400">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- BENTO CARD 2: Luxedrive Headless Booking Engine (1-Col x 2-Row) -->
      <div class="col-span-1 row-span-2 spotlight-card tilt-card group relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--glass-bg)] p-6 flex flex-col justify-between hover:shadow-[0_0_80px_rgba(99,102,241,0.18)] transition-all duration-500">
        <!-- Glow accent background -->
        <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/10 via-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-5">
            <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-[10px] font-bold uppercase tracking-wider">
              Headless Booking Engine
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-black text-[var(--color-text)] mb-3 group-hover:text-indigo-400 transition-colors duration-300">
            Luxedrive Chauffeur
          </h3>
          <p class="text-[var(--color-text-muted)] text-xs sm:text-sm leading-relaxed mb-6">
            A full-stack headless booking application and storefront built for a premium chauffeur booking platform. Implemented customized client-facing schedules, localized currency rendering, and a real-time reservation node syncing client booking workflows.
          </p>

          <!-- Screenshot window with rotating container -->
          <div class="rounded-xl border border-white/5 overflow-hidden h-40 relative bg-black/40">
            <img src="/Luxedrive chauffer service.png" alt="Luxedrive Screenshot" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
          </div>
        </div>

        <div class="flex flex-wrap gap-1.5 mt-6 pt-4 border-t border-white/5">
          {siteConfig.projects[1].skills.map((skill) => (
            <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold border border-indigo-500/20 bg-indigo-500/5 text-indigo-400">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- BENTO CARD 3: Blitz Power Aussie Storefront (1-Col x 1-Row) -->
      <div class="col-span-1 row-span-1 spotlight-card tilt-card group relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--glass-bg)] p-6 flex flex-col justify-between hover:shadow-[0_0_80px_rgba(16,185,129,0.18)] transition-all duration-500">
        <div class="absolute inset-0 bg-gradient-to-br from-lime-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono text-[var(--color-text-muted)]">Shopify Liquid + Alpine.js</span>
            <a href="https://blitzpower.com.au/" target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-1 text-[10px] font-bold text-lime-400 hover:text-white bg-lime-500/10 hover:bg-lime-500/20 rounded px-2.5 py-0.5 transition-colors">
              Live Site
            </a>
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text)] mb-2 group-hover:text-lime-400 transition-colors duration-300">
            Blitz Power Aussie
          </h3>
          <p class="text-[var(--color-text-muted)] text-xs leading-relaxed">
            A high-performance custom storefront layout engineered for an Australian automotive brand. Optimized reactive state filters to yield a mobile PageSpeed score of 95+.
          </p>
        </div>

        <div class="flex flex-wrap gap-1 mt-4 pt-3 border-t border-white/5">
          {siteConfig.projects[2].skills.map((skill) => (
            <span class="px-2 py-0.5 rounded-md text-[9px] font-semibold border border-lime-500/20 bg-lime-500/5 text-lime-400">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- BENTO CARD 4: Headless Shopify & GraphQL Playzone (Interactive Sandbox) -->
      <div class="md:col-span-2 lg:col-span-3 scroll-scale">
        <DevShop client:load />
      </div>
      
    </div>

    <!-- ═══ REGULAR PROJECTS LIST ═══ -->
    <div class="mt-12 space-y-3 scroll-stagger">
      {regular.map((project, index) => (
        <div class="spotlight-card group relative bg-[var(--glass-bg)] rounded-2xl border border-[var(--color-border)] px-6 sm:px-8 py-5 hover:border-[var(--color-primary)]/50 hover:shadow-[0_0_30px_rgba(223, 193, 93,0.1)] hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-start justify-between gap-6">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-2 flex-wrap">
                <span class="text-xs font-mono text-[var(--color-primary)] opacity-40 tracking-wider">
                  ~/{String(featured.length + index + 1).padStart(2, '0')}
                </span>
                <h3 class="text-base sm:text-lg md:text-xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors duration-300">
                  {project.name}
                </h3>
              </div>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-3 max-w-2xl">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {project.skills.map((skill) => (
                  <span class="px-2.5 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded-lg text-xs font-semibold border border-[var(--color-primary)]/20 group-hover:border-[var(--color-primary)]/40 transition-colors duration-300">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
            {project.link && (
              <a href={project.link} target="_blank" rel="noopener noreferrer"
                class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-xl bg-[var(--color-primary)]/10 border border-[var(--color-primary)]/20 text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white hover:shadow-[0_0_20px_rgba(223, 193, 93,0.4)] transition-all duration-300"
                aria-label="View Project">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7V17"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // ===== TILT CARD ANIMATION (Spring Physics) =====
  document.querySelectorAll('.tilt-card').forEach(card => {
    let currentX = 0, currentY = 0;
    let targetX = 0, targetY = 0;
    let currentScale = 1, targetScale = 1;
    let isHovered = false;
    let rafId;

    const lerp = (start, end, amt) => (1 - amt) * start + amt * end;

    const animate = () => {
      currentX = lerp(currentX, targetX, 0.12);
      currentY = lerp(currentY, targetY, 0.12);
      currentScale = lerp(currentScale, targetScale, 0.12);

      card.style.transform = `perspective(1000px) rotateX(${currentY}deg) rotateY(${currentX}deg) scale(${currentScale})`;

      if (
        isHovered || 
        Math.abs(targetX - currentX) > 0.01 || 
        Math.abs(targetY - currentY) > 0.01 ||
        Math.abs(targetScale - currentScale) > 0.001
      ) {
        rafId = requestAnimationFrame(animate);
      } else {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)';
      }
    };

    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      targetX = ((e.clientX - r.left) / r.width - 0.5) * 8; // Y-rot limit
      targetY = -((e.clientY - r.top) / r.height - 0.5) * 8; // X-rot limit
      targetScale = 1.018;
      
      if (!isHovered) {
        isHovered = true;
        cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(animate);
      }
    });

    card.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
      targetScale = 1;
      isHovered = false;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(animate);
    });
  });

  // ===== SPOTLIGHT MOUSE TRACKING =====
  document.querySelectorAll('.spotlight-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
    });
  });

</script>

<style>
  .tilt-card { isolation: isolate; }
  
  /* SVG Transition smoothing */
  circle {
    transition: stroke-dashoffset 1.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
</style>
