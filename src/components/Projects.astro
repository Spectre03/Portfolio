---
import { siteConfig } from "../config";
type Project = typeof siteConfig.projects[number];
const featured = (siteConfig.projects as any[]).filter(p => p.featured);
const regular  = (siteConfig.projects as any[]).filter(p => !p.featured);
---

<section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24 section-alt">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-16">
      <div class="lg:col-span-5 scroll-slide-left">
        <h2 class="clip-reveal text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-[var(--color-text)]">
          Projects
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] accent-bar"></div>
      </div>
      <div class="lg:col-span-7 scroll-fade">
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          Real software built from scratch. Production-grade, not tutorial projects.
        </p>
      </div>
    </div>

    <!-- ═══ Featured cards — mobile: swipe carousel / desktop: 2-col grid ═══ -->

    <!-- Mobile swipe dots indicator -->
    <div class="flex justify-center gap-2 mb-4 lg:hidden" id="carousel-dots">
      {featured.map((_: any, i: number) => (
        <span class="carousel-dot w-2 h-2 rounded-full bg-[var(--color-border)] transition-all duration-300" data-index={i}></span>
      ))}
    </div>

    <!-- Mobile: horizontal snap scroll wrapper -->
    <div class="lg:hidden mb-8 -mx-6 px-6 overflow-x-auto snap-x snap-mandatory scroll-smooth flex gap-4 pb-4 hide-scrollbar" id="projects-carousel">
      {featured.map((project: any, i: number) => (
        <div class="snap-center flex-shrink-0 w-[85vw] max-w-sm spotlight-card featured-project-card group relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--glass-bg)] transition-all duration-500" data-card-index={i}>

          <!-- ─ Preview window ─ -->
          <div class={`relative overflow-hidden bg-gradient-to-br ${project.theme.gradient}`}>
            <div class="flex items-center gap-1.5 px-4 py-2.5 bg-black/30 backdrop-blur-sm border-b border-white/10">
              <span class="w-2.5 h-2.5 rounded-full bg-red-400/90"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/90"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-400/90"></span>
              <div class="ml-2 flex-1 h-5 rounded-md bg-white/10 text-[10px] text-white/50 flex items-center px-3 font-mono truncate">
                {project.isPrivate ? "Private · In Development" : project.link ? project.link.replace("https://","") : "localhost:3000"}
              </div>
              {project.isPrivate ? (
                <span class="ml-2 flex-shrink-0 inline-flex items-center gap-1 text-[10px] font-bold text-white/60 bg-white/10 rounded px-2 py-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  Private
                </span>
              ) : (
                <a href={project.link} target="_blank" rel="noopener noreferrer"
                  class="ml-2 flex-shrink-0 inline-flex items-center gap-1 text-[10px] font-bold text-white/70 bg-white/10 hover:bg-white/20 rounded px-2 py-0.5 transition-colors">
                  <svg width="10" height="10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7V17"/></svg>
                  GitHub
                </a>
              )}
            </div>
            {project.image ? (
              <div class="h-44 overflow-hidden">
                <img src={project.image} alt={`${project.name} screenshot`}
                  class="w-full h-full object-cover"
                  style={`object-position: ${project.imagePosition ?? 'center top'}`}
                  loading="lazy" />
              </div>
            ) : (
              <div class="h-36 relative overflow-hidden flex items-center justify-center">
                <div class="absolute inset-0 hero-grid-bg opacity-30"></div>
                <div class="relative z-10 flex flex-wrap gap-2 justify-center px-4">
                  {project.skills.map((skill: string) => (
                    <span class="px-2.5 py-1 rounded-full bg-white/10 text-white text-xs font-bold border border-white/20">{skill}</span>
                  ))}
                </div>
              </div>
            )}
            <div class="absolute top-10 left-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/40 backdrop-blur-sm text-white text-[10px] font-bold uppercase tracking-wider border border-white/20">★ Featured</span>
            </div>
          </div>

          <div class="p-5">
            <h3 class="text-lg font-bold text-[var(--color-text)] mb-2 group-hover:text-[var(--color-primary)] transition-colors duration-300">{project.name}</h3>
            <p class="text-[var(--color-text-muted)] text-sm leading-relaxed mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.skills.map((skill: string) => (
                <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold border"
                  style={`color:${project.theme.accent};border-color:${project.theme.accent}30;background:${project.theme.accent}12`}>
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Desktop: standard 2-col grid -->
    <div class="hidden lg:grid grid-cols-2 gap-6 mb-8 scroll-stagger">
      {featured.map((project: any) => (
        <div class="tilt-card spotlight-card featured-project-card group relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--glass-bg)] hover:shadow-[0_0_80px_rgba(124,58,237,0.22)] transition-all duration-500">

          <!-- ─ Preview window ─ -->
          <div class={`relative overflow-hidden bg-gradient-to-br ${project.theme.gradient}`}>
            <!-- Browser chrome -->
            <div class="flex items-center gap-1.5 px-4 py-2.5 bg-black/30 backdrop-blur-sm border-b border-white/10">
              <span class="w-2.5 h-2.5 rounded-full bg-red-400/90"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/90"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-400/90"></span>
              <div class="ml-2 flex-1 h-5 rounded-md bg-white/10 text-[10px] text-white/50 flex items-center px-3 font-mono truncate">
                {project.isPrivate ? "Private Repository · In Development" : project.link ? project.link.replace("https://","") : "localhost:3000"}
              </div>
              <!-- GitHub / Private badge -->
              {project.isPrivate ? (
                <span class="ml-2 flex-shrink-0 inline-flex items-center gap-1 text-[10px] font-bold text-white/60 bg-white/10 rounded px-2 py-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  Private
                </span>
              ) : (
                <a href={project.link} target="_blank" rel="noopener noreferrer"
                  class="ml-2 flex-shrink-0 inline-flex items-center gap-1 text-[10px] font-bold text-white/70 bg-white/10 hover:bg-white/20 rounded px-2 py-0.5 transition-colors">
                  <svg width="10" height="10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7V17"/></svg>
                  GitHub
                </a>
              )}
            </div>

            <!-- Screenshot or mockup -->
            {project.image ? (
              <div class="h-56 overflow-hidden">
                <img
                  src={project.image}
                  alt={`${project.name} screenshot`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  style={`object-position: ${project.imagePosition ?? 'center top'}`}
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="h-44 relative overflow-hidden flex items-center justify-center">
                <!-- Grid overlay -->
                <div class="absolute inset-0 hero-grid-bg opacity-30"></div>
                <!-- Glow -->
                <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/30"></div>
                <!-- Tech pills -->
                <div class="relative z-10 flex flex-wrap gap-2 justify-center px-6">
                  {project.skills.map((skill: string) => (
                    <span class="px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-sm text-white text-xs font-bold border border-white/20">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- Featured label -->
            <div class="absolute top-10 left-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/40 backdrop-blur-sm text-white text-[10px] font-bold uppercase tracking-wider border border-white/20">
                ★ Featured
              </span>
            </div>
          </div>

          <!-- ─ Content ─ -->
          <div class="p-6 sm:p-8">
            <h3 class="text-xl sm:text-2xl font-bold text-[var(--color-text)] mb-3 group-hover:text-[var(--color-primary)] transition-colors duration-300">
              {project.name}
            </h3>
            <p class="text-[var(--color-text-muted)] leading-relaxed text-sm sm:text-base mb-5">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {project.skills.map((skill: string) => (
                <span class="px-2.5 py-1 rounded-lg text-xs font-semibold border"
                  style={`color: ${project.theme.accent}; border-color: ${project.theme.accent}30; background: ${project.theme.accent}12`}>
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- ═══ Regular projects ═══ -->
    <div class="space-y-3 scroll-stagger">
      {regular.map((project: any, index: number) => (
        <div class="spotlight-card group relative bg-[var(--glass-bg)] rounded-2xl border border-[var(--color-border)] px-6 sm:px-8 py-5 hover:border-[var(--color-primary)]/50 hover:shadow-[0_0_30px_rgba(124,58,237,0.1)] hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-start justify-between gap-6">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-2 flex-wrap">
                <span class="text-xs font-mono text-[var(--color-primary)] opacity-40 tracking-wider">
                  ~/{String(featured.length + index + 1).padStart(2, '0')}
                </span>
                <h3 class="text-base sm:text-lg md:text-xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors duration-300">
                  {project.name}
                </h3>
              </div>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-3 max-w-2xl">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {project.skills.map((skill: string) => (
                  <span class="px-2.5 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded-lg text-xs font-semibold border border-[var(--color-primary)]/20 group-hover:border-[var(--color-primary)]/40 transition-colors duration-300">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
            {project.link && (
              <a href={project.link} target="_blank" rel="noopener noreferrer"
                class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-xl bg-[var(--color-primary)]/10 border border-[var(--color-primary)]/20 text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white hover:shadow-[0_0_20px_rgba(124,58,237,0.4)] transition-all duration-300"
                aria-label="View on GitHub">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7V17"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // 3D tilt on featured project cards
  document.querySelectorAll<HTMLElement>('.tilt-card').forEach(card => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width  - 0.5;
      const y = (e.clientY - r.top)  / r.height - 0.5;
      card.style.transform = `perspective(800px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg) scale(1.015)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(800px) rotateY(0) rotateX(0) scale(1)';
    });
  });

  // Spotlight mouse tracking
  document.querySelectorAll<HTMLElement>('.spotlight-card').forEach(card => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
    });
  });

  // Mobile carousel dot indicators
  (function () {
    const carousel = document.getElementById('projects-carousel');
    const dots = document.querySelectorAll<HTMLElement>('.carousel-dot');
    if (!carousel || !dots.length) return;

    const updateDots = () => {
      const cardWidth = carousel.querySelector<HTMLElement>('[data-card-index]')?.offsetWidth ?? 0;
      const gap = 16;
      const index = Math.round(carousel.scrollLeft / (cardWidth + gap));
      dots.forEach((dot, i) => {
        dot.style.background = i === index
          ? 'var(--color-primary)'
          : 'var(--color-border)';
        dot.style.width = i === index ? '20px' : '8px';
      });
    };

    carousel.addEventListener('scroll', updateDots, { passive: true });
    updateDots();

    // Tap dot to scroll to card
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const cardWidth = carousel.querySelector<HTMLElement>('[data-card-index]')?.offsetWidth ?? 0;
        carousel.scrollTo({ left: i * (cardWidth + 16), behavior: 'smooth' });
      });
    });
  })();
</script>

<style>
  .tilt-card { isolation: isolate; }

  /* Hide scrollbar on carousel but keep scroll functionality */
  .hide-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
  .hide-scrollbar::-webkit-scrollbar { display: none; }

  /* Carousel dot pill transition */
  .carousel-dot {
    transition: width 0.3s cubic-bezier(0.34,1.56,0.64,1), background 0.3s ease;
    cursor: pointer;
  }
</style>
