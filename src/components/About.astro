---
import { siteConfig } from "../config";
const skillCategories = Object.entries(siteConfig.skills);

const quickFacts = [
  { value: "3+",     label: "Years Coding",         sub: "Since 2022"           },
  { value: "7+",     label: "Projects Shipped",      sub: "Production-grade"     },
  { value: "9",      label: "Certifications",        sub: "Verified credentials" },
  { value: "Remote", label: "Worldwide Available",   sub: "UTC+5 · Flexible hrs" },
];
---

<section id="about" class="px-5 py-16 sm:px-10 sm:py-20 md:p-16 lg:p-24 section-alt">
  <div class="max-w-7xl mx-auto relative z-10">

    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-16">
      <div class="lg:col-span-5 scroll-slide-left">
        <h2 class="clip-reveal text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-[var(--color-text)]">
          About Me
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] accent-bar"></div>
      </div>
      <div class="lg:col-span-7 scroll-fade">
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          Shopify Hydrogen specialist and full-stack developer based in Islamabad, Pakistan.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

      <!-- Left: Facts + bio + availability -->
      <div class="lg:col-span-5 space-y-8">

        <!-- Quick-fact 2×2 grid -->
        <div class="grid grid-cols-2 gap-4 scroll-stagger" id="about-facts">
          {quickFacts.map((fact) => (
            <div class="tilt-card spotlight-card group p-5 rounded-2xl bg-[var(--glass-bg)] border border-[var(--color-border)] hover:border-[var(--color-primary)]/60 hover:shadow-[0_0_30px_rgba(223, 193, 93,0.12)] transition-all duration-300 cursor-default">
              <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] mb-1 fact-value"
                data-target={fact.value}>
                {fact.value}
              </div>
              <div class="text-sm font-bold text-[var(--color-text)] leading-tight">{fact.label}</div>
              <div class="text-[11px] text-[var(--color-text-muted)] mt-0.5">{fact.sub}</div>
            </div>
          ))}
        </div>

        <!-- Bio -->
        <div class="scroll-fade space-y-3">
          <p class="text-base sm:text-lg leading-relaxed text-[var(--color-text-muted)]">
            SE student at <span class="text-[var(--color-text)] font-medium">Riphah</span>, freelancing since my second year. I've built across a lot of ground: Shopify Hydrogen storefronts, full-stack apps in .NET, PHP, and MERN, and mobile with Flutter. The stack changes with the project, the standard doesn't.
          </p>
          <p class="text-base sm:text-lg leading-relaxed text-[var(--color-text-muted)]">
            I care about ownership. Understanding what the product actually needs and making sure it gets there, from the first commit to after it ships.
          </p>
        </div>

        <!-- Availability pill -->
        <div class="scroll-fade">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-green-500/30 bg-green-500/10">
            <span class="relative flex h-2 w-2 flex-shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400"></span>
            </span>
            <span class="text-xs font-semibold text-green-400 tracking-wide">{siteConfig.availability}</span>
          </div>
        </div>
      </div>

      <!-- Right: Categorized skills -->
      <div class="lg:col-span-7 space-y-6">
        <div class="scroll-slide-left mb-2">
          <h3 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)]">Skills & Stack</h3>
          <div class="w-16 h-1 mt-2 rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)]"></div>
        </div>

        {skillCategories.map(([category, skills], i) => (
          <div class="scroll-fade" style={`animation-delay: ${i * 0.07}s`}>
            <p class="font-mono text-[11px] text-[var(--color-primary)] mb-2.5 flex items-center gap-1.5 opacity-80">
              <span class="opacity-50">//</span>
              <span class="tracking-widest uppercase font-black">{category}</span>
            </p>
            <div class="flex flex-wrap gap-2">
              {(skills as string[]).map((skill) => (
                <span class="skill-pill px-3 py-1.5 rounded-lg text-sm font-medium text-[var(--color-text)] bg-[var(--glass-bg)] border border-[var(--color-border)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] hover:shadow-[0_0_10px_rgba(223, 193, 93,0.2)] transition-all duration-250 cursor-default">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  // ===== ABOUT FACT COUNTERS =====
  const factsGrid = document.getElementById('about-facts');
  if (factsGrid) {
    const obs = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      obs.disconnect();
      factsGrid.querySelectorAll<HTMLElement>('.fact-value').forEach(el => {
        const raw = el.dataset.target ?? '';
        const num = parseInt(raw);
        if (isNaN(num)) return; // skip "Remote"
        const suffix = raw.replace(String(num), '');
        let current = 0;
        const steps = 35;
        const inc = num / steps;
        const timer = setInterval(() => {
          current = Math.min(current + inc, num);
          el.textContent = Math.round(current) + suffix;
          if (current >= num) clearInterval(timer);
        }, 1200 / steps);
      });
    }, { threshold: 0.5 });
    obs.observe(factsGrid);
  }

  // High-performance spring-lerped 3D tilt on quick-fact cards
  document.querySelectorAll<HTMLElement>('#about .tilt-card').forEach(card => {
    let currentX = 0, currentY = 0;
    let targetX = 0, targetY = 0;
    let currentScale = 1, targetScale = 1;
    let isHovered = false;
    let rafId: number;

    const lerp = (start: number, end: number, amt: number) => (1 - amt) * start + amt * end;

    const animate = () => {
      currentX = lerp(currentX, targetX, 0.12);
      currentY = lerp(currentY, targetY, 0.12);
      currentScale = lerp(currentScale, targetScale, 0.12);

      card.style.transform = `perspective(600px) rotateX(${currentY}deg) rotateY(${currentX}deg) scale(${currentScale})`;

      if (
        isHovered || 
        Math.abs(targetX - currentX) > 0.01 || 
        Math.abs(targetY - currentY) > 0.01 ||
        Math.abs(targetScale - currentScale) > 0.001
      ) {
        rafId = requestAnimationFrame(animate);
      } else {
        card.style.transform = 'perspective(600px) rotateX(0deg) rotateY(0deg) scale(1)';
      }
    };

    let r = card.getBoundingClientRect();
    
    card.addEventListener('mouseenter', () => {
      r = card.getBoundingClientRect();
      targetScale = 1.03;
      isHovered = true;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(animate);
    });

    card.addEventListener('mousemove', (e: MouseEvent) => {
      targetX = ((e.clientX - r.left) / r.width - 0.5) * 12; // max Y-rotation: 12deg
      targetY = -((e.clientY - r.top) / r.height - 0.5) * 12; // max X-rotation: 12deg
    });

    card.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
      targetScale = 1;
      isHovered = false;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(animate);
    });
  });
</script>

<style>
  .skill-pill { isolation: isolate; }
</style>
