---
import { siteConfig } from "../config";

// Real brand icons via Simple Icons CDN — always correct, always current
const brandIcon: Record<string, { slug: string; color: string }> = {
  "Shopify":       { slug: "shopify",       color: "#96BF48" },
  "Shopify Partner Developer Track": { slug: "shopify", color: "#96BF48" },
  "IBM / Coursera":{ slug: "ibm",           color: "#1F70C1" },
  "IBM":           { slug: "ibm",           color: "#1F70C1" },
  "Coursera":      { slug: "coursera",      color: "#0056D2" },
  "freeCodeCamp":  { slug: "freecodecamp",  color: "#3CD69D" },
  "Google":        { slug: "google",        color: "#4285F4" },
  "Cisco":         { slug: "cisco",         color: "#1BA0D7" },
};

const { certifications } = siteConfig;
---

<section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div class="max-w-7xl mx-auto relative z-10">

    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-14">
      <div class="lg:col-span-4 scroll-slide-left">
        <h2 class="clip-reveal text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-[var(--color-text)]">
          Certifications
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] accent-bar"></div>
      </div>
      <div class="lg:col-span-8 scroll-fade">
        <p class="text-lg text-[var(--color-text-muted)] max-w-xl leading-relaxed">
          Verified credentials across e-commerce, full-stack development, networking, and AI fundamentals.
        </p>
      </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {certifications.map((cert, index) => {
        // Resolve brand mapping cleanly via keyword search
        const issuerLower = cert.issuer.toLowerCase();
        let slug = "";
        let color = cert.brandColor;

        if (issuerLower.includes("shopify")) {
          slug = "shopify";
          color = "#96BF48";
        } else if (issuerLower.includes("ibm")) {
          slug = "ibm";
          color = "#1F70C1";
        } else if (issuerLower.includes("coursera")) {
          slug = "coursera";
          color = "#0056D2";
        } else if (issuerLower.includes("freecodecamp")) {
          slug = "freecodecamp";
          color = "#3CD69D";
        } else if (issuerLower.includes("google")) {
          slug = "google";
          color = "#4285F4";
        } else if (issuerLower.includes("cisco")) {
          slug = "cisco";
          color = "#1BA0D7";
        }

        const isRealIcon = slug !== "";
        const iconUrl = isRealIcon ? `https://cdn.simpleicons.org/${slug}/${color.replace('#','').toLowerCase()}` : "";

        return (
          <div
            class="spotlight-card group relative bg-[var(--glass-bg)] rounded-2xl border border-[var(--color-border)] p-6 hover:border-[var(--color-primary)]/60 hover:shadow-[0_0_30px_rgba(223,193,93,0.12)] hover:-translate-y-1 transition-all duration-400 scroll-fade"
            style={`animation-delay: ${index * 0.06}s`}
          >
            <!-- Brand icon -->
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center mb-5 transition-transform duration-400 group-hover:scale-110 shadow-lg"
              style={`background: ${color}18; border: 1px solid ${color}30`}
            >
              {isRealIcon ? (
                <img
                  src={iconUrl}
                  alt={cert.issuer}
                  width="24"
                  height="24"
                  loading="lazy"
                  class="w-6 h-6 object-contain"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
                />
              ) : null}
              <!-- Fallback text badge -->
              <span
                class={isRealIcon ? "hidden text-xs font-bold" : "text-xs font-bold"}
                style={`color: ${color}`}
              >
                {cert.brandInitial}
              </span>
            </div>

            <!-- Cert name -->
            <h3 class="text-base font-bold text-[var(--color-text)] mb-2 group-hover:text-[var(--color-text)] transition-colors duration-300 leading-snug">
              {cert.name}
            </h3>

            <!-- Issuer + date -->
            <div class="flex items-center justify-between mt-auto pt-3 border-t border-[var(--color-border)]">
              <span class="text-sm font-semibold" style={`color: ${color}`}>
                {cert.issuer}
              </span>
              <span class="text-xs text-[var(--color-text-muted)] font-mono bg-[var(--color-bg)] px-2 py-0.5 rounded-md">
                v{cert.date}
              </span>
            </div>

            <!-- Corner glow -->
            <div
              class="absolute top-0 right-0 w-20 h-20 rounded-bl-[2rem] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              style={`background: linear-gradient(135deg, ${color}15, transparent)`}
            ></div>
          </div>
        );
      })}
    </div>
  </div>
</section>
