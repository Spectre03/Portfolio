---
import { siteConfig } from "../config";
---

<footer class="relative overflow-hidden border-t border-[var(--color-border)]">

  <!-- Background -->
  <div class="absolute inset-0 hero-grid-bg opacity-50 pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-gradient-to-t from-[var(--color-primary)]/8 to-transparent blur-3xl rounded-full pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-8 sm:px-12 md:px-16 lg:px-24 pt-20 pb-10">

    <!-- Big closing line -->
    <div class="text-center mb-16 scroll-fade">
      <p class="text-xs font-bold tracking-widest uppercase text-[var(--color-primary)] mb-4">Based in Islamabad · Available worldwide</p>
      <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-[var(--color-text)] leading-tight">
        Got a project in mind?<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)]">Let's talk.</span>
      </h2>
      <div class="mt-8 flex items-center justify-center gap-4 flex-wrap">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] text-[var(--color-btn-text)] font-bold rounded-xl hover:shadow-[0_0_40px_rgba(223, 193, 93,0.5)] hover:-translate-y-1 transition-all duration-300 text-base"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Send a Message
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px bg-gradient-to-r from-transparent via-[var(--color-border)] to-transparent mb-10"></div>

    <!-- Bottom row -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <!-- Left: Name + tagline -->
      <div>
        <p class="font-bold text-[var(--color-text)] text-lg">
          {siteConfig.name}<span class="text-[var(--color-primary)]">.</span>
        </p>
        <p class="text-sm text-[var(--color-text-muted)] mt-0.5">{siteConfig.title}</p>
      </div>

      <!-- Center: Nav links -->
      <nav class="flex items-center gap-6 flex-wrap justify-center">
        {["about", "projects", "experience", "certifications", "contact"].map((link) => (
          <a
            href={`#${link}`}
            class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors duration-300 capitalize"
          >
            {link}
          </a>
        ))}
      </nav>

      <!-- Right: Social icons -->
      <div class="flex items-center gap-3">
        {siteConfig.social.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"
            class="p-2.5 rounded-xl glass border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-primary)] hover:border-[var(--color-primary)]/40 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          </a>
        )}
        {siteConfig.social.linkedin && (
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
            class="p-2.5 rounded-xl glass border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-primary)] hover:border-[var(--color-primary)]/40 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        )}
        <a href={siteConfig.resume} download aria-label="Download Resume"
          class="p-2.5 rounded-xl glass border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-primary)] hover:border-[var(--color-primary)]/40 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <p class="text-center text-xs text-[var(--color-text-muted)]/50 mt-8">
      © {new Date().getFullYear()} {siteConfig.name}. Built with Astro · Designed to impress.
    </p>

  </div>
</footer>
