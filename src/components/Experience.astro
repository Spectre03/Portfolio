---
import { siteConfig } from "../config";
const { experience } = siteConfig;
---

{experience && experience.length > 0 && (
  <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24">
    <div class="max-w-7xl mx-auto">

      <!-- Header -->
      <div class="text-center mb-16 scroll-fade">
        <h2 class="clip-reveal text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-[var(--color-text)] mb-3">
          Experience
        </h2>
        <div class="w-[75px] h-[5px] mx-auto rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] accent-bar"></div>
      </div>

      <!-- Center timeline -->
      <div class="relative max-w-4xl mx-auto">

        <!-- Vertical line — center on desktop, left on mobile -->
        <div class="absolute left-5 md:left-1/2 top-0 bottom-0 w-px timeline-line md:-translate-x-1/2"></div>

        <div class="space-y-10 md:space-y-0">
          {experience.map((exp, index) => {
            const isLeft = index % 2 === 0;
            return (
              <div class={`relative flex flex-col md:flex-row md:items-start gap-0 md:gap-8 pl-14 md:pl-0 ${isLeft ? '' : 'md:flex-row-reverse'} md:mb-16`}>

                <!-- Card -->
                <div class={`group w-full md:w-[calc(50%-2rem)] bg-[var(--glass-bg)] rounded-2xl border border-[var(--color-border)] p-6 sm:p-8 hover:border-[var(--color-primary)]/60 hover:shadow-[0_0_40px_rgba(124,58,237,0.12)] transition-all duration-300 hover:-translate-y-1 ${isLeft ? 'scroll-slide-left' : 'scroll-slide-right'}`}>

                  <!-- Git-style top decoration -->
                  <div class="flex items-center gap-2 mb-4 font-mono text-[11px] text-[var(--color-text-muted)]/50">
                    <span class="text-[var(--color-primary)] opacity-70">◆</span>
                    <span>feat/{exp.company.toLowerCase().replace(/\s/g,'-')}</span>
                    <span class="ml-auto text-[10px] tracking-wider">{exp.dateRange}</span>
                  </div>
                  <!-- Top row -->
                  <div class="flex flex-col gap-1 mb-5">
                    <h3 class="text-xl sm:text-2xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors duration-300">
                      {exp.title}
                    </h3>
                    <p class="text-base font-bold text-[var(--color-primary)]">{exp.company}</p>
                  </div>

                  <!-- Bullets -->
                  <ul class="space-y-2.5">
                    {exp.bullets.map((bullet) => (
                      <li class="flex items-start gap-3">
                        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)] mt-2 flex-shrink-0 shadow-[0_0_6px_rgba(124,58,237,0.6)]"></span>
                        <span class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Dot — left on mobile, center on desktop -->
                <div class="flex absolute left-5 md:left-1/2 top-6 md:top-8 -translate-x-1/2 w-5 h-5 rounded-full border-2 border-[var(--color-primary)] bg-[var(--color-bg)] z-10 items-center justify-center shadow-[0_0_16px_rgba(124,58,237,0.6)]">
                  <div class="w-2 h-2 rounded-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-accent)]"></div>
                </div>

              </div>
            );
          })}
        </div>

      </div>
    </div>
  </section>
)}
