---
import { siteConfig } from "../config";
const { education } = siteConfig;
---

{education && education.length > 0 && (
  <section id="education" class="p-8 sm:p-12 md:p-16 lg:p-24">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

        <div class="lg:col-span-4 scroll-slide-left">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-[var(--color-text)]">
            Education
          </h2>
          <div class="w-[75px] h-[5px] mt-2 rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] accent-bar"></div>
        </div>

        <div class="lg:col-span-8">
          <div class="space-y-6 scroll-stagger">
            {education.map((edu, index) => (
              <div class="group relative bg-[var(--glass-bg)] rounded-2xl border border-[var(--color-border)] p-6 sm:p-8 hover:border-[var(--color-primary)]/60 hover:shadow-[0_0_30px_rgba(124,58,237,0.12)] transition-all duration-300">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-3">
                  <div class="flex-1">
                    <h3 class="text-xl sm:text-2xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors duration-300">
                      {edu.degree}
                    </h3>
                    <p class="text-base text-[var(--color-primary)] font-semibold mt-1">
                      {edu.school}
                    </p>
                  </div>
                  <span class="text-sm text-[var(--color-text-muted)] font-mono whitespace-nowrap">
                    {edu.dateRange}
                  </span>
                </div>

                {edu.achievements && edu.achievements.length > 0 && (
                  <ul class="space-y-2 mt-4">
                    {edu.achievements.map((a) => (
                      <li class="flex items-start gap-3">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-primary)] mt-2 flex-shrink-0"></span>
                        <span class="text-sm text-[var(--color-text-muted)]">{a}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="absolute top-6 sm:top-8 right-6 sm:right-8 text-4xl font-black text-[var(--color-primary)] opacity-5 group-hover:opacity-10 transition-opacity duration-300 select-none">
                  {String(index + 1).padStart(2, '0')}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
)}
