---
const phases = [
  {
    num: "01",
    tag: "Understand",
    title: "Deep Dive First",
    body: "I don't write a line of code until I understand what you're actually building, who uses it, and what done looks like. Requirements first, then architecture, then code.",
    bullets: ["Requirements & scope clarity", "Architecture planning", "Tech stack decisions", "Timeline & milestone setup"],
    image: "/Phase 1.png",
    color: "var(--color-primary)",
  },
  {
    num: "02",
    tag: "Build",
    title: "Iterate Fast, Ship Often",
    body: "I build in focused sprints and share working demos, not slideshows. Regular updates, honest communication, no surprises at the end.",
    bullets: ["Sprint-based delivery", "Working demos at every stage", "Daily/weekly updates", "Feedback loops built in"],
    image: "/Phase 2.png",
    color: "var(--color-accent)",
  },
  {
    num: "03",
    tag: "Ship",
    title: "Deploy & Hand Over Clean",
    body: "Performance tuning, final QA, clean documentation, and a handover that actually makes sense. You own your code. No vendor lock-in, no mystery boxes.",
    bullets: ["Performance optimisation", "Full QA & testing", "Clean documentation", "You own everything"],
    image: "/Phase 3.png",
    color: "#a855f7",
  },
];
---

<section id="approach" class="relative py-20 sm:py-32 overflow-hidden">

  <div class="absolute top-1/4 left-0 w-96 h-96 bg-[var(--color-primary)] opacity-5 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-0 w-96 h-96 bg-[var(--color-accent)] opacity-5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 relative z-10">

    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-14">
      <div class="lg:col-span-4 scroll-slide-left">
        <h2 class="clip-reveal text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-[var(--color-text)]">How I Work</h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] accent-bar"></div>
      </div>
      <div class="lg:col-span-8 scroll-fade">
        <p class="text-lg text-[var(--color-text-muted)] max-w-xl leading-relaxed">
          No vague promises. No disappearing acts. A clear process that ships real, working software.
        </p>
      </div>
    </div>

    <!-- Step tabs -->
    <div class="flex gap-3 mb-10 scroll-fade">
      {phases.map((p, i) => (
        <button
          class="phase-tab flex items-center gap-2.5 px-5 py-3 rounded-xl border transition-all duration-300 text-sm font-bold"
          data-phase={i}
          style={i === 0 ? `border-color:${p.color}40; background:${p.color}15; color:${p.color}` : ''}
        >
          <span class="text-xs font-mono opacity-60">{p.num}</span>
          {p.tag}
        </button>
      ))}
    </div>

    <!-- Content area -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Left: text -->
      <div class="phase-content-wrap scroll-slide-left">
        {phases.map((p, i) => (
          <div class="phase-content" data-phase={i} style={i !== 0 ? 'display:none' : ''}>
            <div class="flex items-center gap-3 mb-5">
              <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-2xl font-black text-white shadow-lg" style={`background: linear-gradient(135deg, ${p.color}, ${p.color}99)`}>
                {p.num}
              </div>
              <div>
                <span class="text-xs font-black tracking-widest uppercase" style={`color:${p.color}`}>{p.tag}</span>
                <h3 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)]">{p.title}</h3>
              </div>
            </div>
            <p class="text-[var(--color-text-muted)] leading-relaxed mb-6">{p.body}</p>
            <ul class="space-y-2.5">
              {p.bullets.map(b => (
                <li class="flex items-center gap-3 text-sm text-[var(--color-text)]">
                  <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0" style={`background:${p.color}20`}>
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                      <path d="M2 5l2.5 2.5L8 2.5" stroke={p.color} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Right: screenshot -->
      <div class="scroll-fade">
        <div class="relative rounded-2xl overflow-hidden border border-[var(--color-border)] bg-[var(--glass-bg)] shadow-xl">
          <!-- Browser chrome -->
          <div class="flex items-center gap-1.5 px-4 py-2.5 bg-black/30 border-b border-white/10">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400/90"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/90"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-400/90"></span>
            <div class="ml-2 flex-1 h-5 rounded-md bg-white/10 text-[10px] text-white/50 flex items-center px-3 font-mono" id="phase-url">
              phase-01 / understand
            </div>
          </div>
          <div class="relative h-64 sm:h-72 overflow-hidden" id="phase-img-wrap">
            {phases.map((p, i) => (
              <img
                src={p.image}
                alt={`Phase ${p.num}`}
                class="phase-img absolute inset-0 w-full h-full object-cover object-top transition-opacity duration-500"
                style={i !== 0 ? 'opacity:0' : 'opacity:1'}
                data-phase={i}
                loading="lazy"
              />
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- Progress bar -->
    <div class="flex gap-2 mt-10 scroll-fade">
      {phases.map((p, i) => (
        <div class="phase-bar flex-1 h-1 rounded-full bg-[var(--color-border)] overflow-hidden">
          <div class="phase-bar-fill h-full rounded-full transition-all duration-500 origin-left" data-phase={i}
            style={i === 0 ? `background:${p.color}; transform:scaleX(1)` : 'transform:scaleX(0)'}></div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const phases = [
    { color: 'var(--color-primary)', url: 'phase-01 / understand' },
    { color: 'var(--color-accent)',  url: 'phase-02 / build'      },
    { color: '#a855f7',              url: 'phase-03 / ship'       },
  ];

  let active = 0;
  const tabs    = document.querySelectorAll<HTMLElement>('.phase-tab');
  const content = document.querySelectorAll<HTMLElement>('.phase-content');
  const imgs    = document.querySelectorAll<HTMLElement>('.phase-img');
  const bars    = document.querySelectorAll<HTMLElement>('.phase-bar-fill');
  const urlEl   = document.getElementById('phase-url');

  function activate(i: number) {
    // tabs
    tabs.forEach((t, ti) => {
      const p = phases[ti];
      if (ti === i) {
        t.style.borderColor = p.color + '40';
        t.style.background  = p.color + '15';
        t.style.color       = p.color;
      } else {
        t.style.borderColor = '';
        t.style.background  = '';
        t.style.color       = '';
      }
    });
    // content
    content.forEach((c, ci) => { c.style.display = ci === i ? '' : 'none'; });
    // images
    imgs.forEach((img, ii) => { img.style.opacity = ii === i ? '1' : '0'; });
    // bars
    bars.forEach((b, bi) => { b.style.transform = bi === i ? 'scaleX(1)' : 'scaleX(0)'; b.style.background = bi === i ? phases[bi].color : ''; });
    // url
    if (urlEl) urlEl.textContent = phases[i].url;
    active = i;
  }

  tabs.forEach((t, i) => t.addEventListener('click', () => activate(i)));

  // Auto-advance every 5s
  setInterval(() => activate((active + 1) % phases.length), 5000);
</script>

<style>
  .phase-tab {
    border-color: var(--color-border);
    color: var(--color-text-muted);
    background: transparent;
    cursor: pointer;
  }
  .phase-tab:hover {
    border-color: rgba(223, 193, 93,0.3);
    color: var(--color-text);
  }
</style>
