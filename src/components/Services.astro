---
// What I Build — Services section
const services = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"/></svg>`,
    label: "01",
    title: "Shopify Hydrogen Storefronts",
    description: "Headless commerce built for speed and conversion. Custom Remix themes, Storefront API, optimized cart and checkout flows that actually sell.",
    tags: ["Hydrogen", "Remix", "GraphQL", "TypeScript"],
    color: "#96BF48",
    glow: "rgba(150, 191, 72, 0.15)",
    border: "rgba(150, 191, 72, 0.25)",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5 3 12l3.75 4.5m10.5 0L21 12l-3.75-4.5M14.25 4.5l-4.5 15"/></svg>`,
    label: "02",
    title: "Full-Stack Web Apps",
    description: "End-to-end applications built from database to UI. Scalable architecture, clean APIs, and polished frontends that hold up in production.",
    tags: ["React", "Next.js", "Node.js", "ASP.NET"],
    color: "#7c3aed",
    glow: "rgba(124, 58, 237, 0.15)",
    border: "rgba(124, 58, 237, 0.25)",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>`,
    label: "03",
    title: "Mobile Apps (Flutter)",
    description: "Cross-platform apps with native performance. Single codebase shipping to iOS and Android, with AI integrations where it actually makes sense.",
    tags: ["Flutter", "Dart", "Gemini AI", "Firebase"],
    color: "#06b6d4",
    glow: "rgba(6, 182, 212, 0.15)",
    border: "rgba(6, 182, 212, 0.25)",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3M12 3v4.5m0 0-1.5-1.5M12 7.5l1.5-1.5"/></svg>`,
    label: "04",
    title: "APIs & Backend Systems",
    description: "RESTful APIs, role-based auth, database design, and third-party integrations (OpenAI, payment gateways, SMS/email) built to production standards.",
    tags: ["REST APIs", "SQL Server", "MongoDB", "OpenAI"],
    color: "#f59e0b",
    glow: "rgba(245, 158, 11, 0.15)",
    border: "rgba(245, 158, 11, 0.25)",
  },
];
---

<section id="services" class="py-24 sm:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24">

    <!-- Header -->
    <div class="text-center mb-16">
      <p class="font-mono text-xs tracking-[0.25em] uppercase text-[var(--color-primary)] mb-4 scroll-fade opacity-80">
        — What I Build —
      </p>
      <h2 class="clip-reveal text-4xl sm:text-5xl md:text-6xl font-extrabold text-[var(--color-text)] mb-4">
        Services
      </h2>
      <div class="w-[60px] h-[4px] mx-auto rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] accent-bar mb-5"></div>
      <p class="text-[var(--color-text-muted)] max-w-xl mx-auto scroll-fade">
        Full-cycle development across web, mobile, and commerce. You bring the vision, I ship the product.
      </p>
    </div>

    <!-- 2×2 Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 scroll-stagger">
      {services.map((svc) => (
        <div
          class="service-card group relative rounded-2xl p-7 border overflow-hidden cursor-default transition-all duration-500 hover:-translate-y-1.5"
          style={`border-color: ${svc.border}; background: linear-gradient(135deg, rgba(11,16,34,0.7) 0%, rgba(11,16,34,0.4) 100%);`}
        >
          <!-- Glow blob on hover -->
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-2xl"
            style={`background: radial-gradient(ellipse 80% 60% at 20% 20%, ${svc.glow}, transparent 70%);`}
          ></div>

          <!-- Animated corner accent -->
          <div class="absolute top-0 right-0 w-24 h-24 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none overflow-hidden rounded-2xl">
            <div class="absolute top-0 right-0 w-px h-16 origin-top scale-y-0 group-hover:scale-y-100 transition-transform duration-500" style={`background: linear-gradient(to bottom, ${svc.color}, transparent);`}></div>
            <div class="absolute top-0 right-0 h-px w-16 origin-right scale-x-0 group-hover:scale-x-100 transition-transform duration-500" style={`background: linear-gradient(to left, ${svc.color}, transparent);`}></div>
          </div>

          <!-- Number label -->
          <div class="relative z-10">
            <p class="font-mono text-[10px] tracking-[0.2em] mb-4 font-bold opacity-30" style={`color: ${svc.color};`}>
              {svc.label}
            </p>

            <!-- Icon -->
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center mb-5 transition-all duration-300 group-hover:scale-110"
              style={`color: ${svc.color}; background: ${svc.glow}; box-shadow: 0 0 20px ${svc.glow};`}
            >
              <Fragment set:html={svc.icon} />
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-[var(--color-text)] mb-3 transition-colors duration-300" style={`group-hover: color: ${svc.color};`}>
              {svc.title}
            </h3>

            <!-- Description -->
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-5">
              {svc.description}
            </p>

            <!-- Tech tags -->
            <div class="flex flex-wrap gap-2">
              {svc.tags.map(tag => (
                <span
                  class="px-2.5 py-1 rounded-lg text-[11px] font-bold border transition-all duration-300"
                  style={`color: ${svc.color}; border-color: ${svc.border}; background: ${svc.glow};`}
                >
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .service-card {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(124,58,237,0.06), transparent 40%);
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: inherit;
  }
  .service-card:hover::before { opacity: 1; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.service-card').forEach(card => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
    });
  });
</script>
