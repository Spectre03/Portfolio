---
---
<!-- High-End 3D WebGL Fresnel Glass Sphere -->
<div class="glass-orb-container group">
  <canvas id="hero-glass-canvas"></canvas>
  
  <!-- Subtle glass ambient shadows -->
  <div class="absolute -inset-10 bg-gradient-to-tr from-[var(--color-primary)]/10 via-[var(--color-accent)]/5 to-transparent rounded-full filter blur-3xl opacity-60 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 pointer-events-none"></div>
</div>

<style>
  .glass-orb-container {
    position: relative;
    width: 320px;
    height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 1024px) {
    .glass-orb-container {
      width: 400px;
      height: 400px;
    }
  }
  #hero-glass-canvas {
    width: 100%;
    height: 100%;
    display: block;
    z-index: 10;
  }
</style>

<script>
  import * as THREE from 'three';

  // ===== SHADERS: FRESNEL GLASS SHADER =====
  const vertexShader = `
    uniform float uTime;
    uniform vec2 uMouse;
    varying vec3 vNormal;
    varying vec3 vViewPosition;
    varying float vNoise;

    // Simplex noise implementation
    vec4 permute(vec4 x){return mod(((x*34.0)+1.0)*x, 289.0);}
    vec4 taylorInvSqrt(vec4 r){return 1.79284291400159 - 0.85373472095314 * r;}
    float snoise(vec3 v){
      const vec2  C = vec2(1.0/6.0, 1.0/3.0) ;
      const vec4  D = vec4(0.0, 0.5, 1.0, 2.0);
      vec3 i  = floor(v + dot(v, C.yyy) );
      vec3 x0 =   v - i + dot(i, C.xxx) ;
      vec3 g = step(x0.yzx, x0.xyz);
      vec3 l = 1.0 - g;
      vec3 i1 = min( g.xyz, l.zxy );
      vec3 i2 = max( g.xyz, l.zxy );
      vec3 x1 = x0 - i1 + 1.0 * C.xxx;
      vec3 x2 = x0 - i2 + 2.0 * C.xxx;
      vec3 x3 = x0 - D.yyy;
      i = mod(i, 289.0 );
      vec4 p = permute( permute( permute(
                 i.z + vec4(0.0, i1.z, i2.z, 1.0 ))
               + i.y + vec4(0.0, i1.y, i2.y, 1.0 ))
               + i.x + vec4(0.0, i1.x, i2.x, 1.0 ));
      float n_ = 0.142857142857;
      vec3  ns = n_ * D.wyz - D.xzx;
      vec4 j = p - 49.0 * floor(p * ns.z *ns.z);
      vec4 x_ = floor(j * ns.z);
      vec4 y_ = floor(j - 7.0 * x_ );
      vec4 x = x_ *ns.x + ns.yyyy;
      vec4 y = y_ *ns.x + ns.yyyy;
      vec4 h = 1.0 - abs(x) - abs(y);
      vec4 b0 = vec4( x.xy, y.xy );
      vec4 b1 = vec4( x.zw, y.zw );
      vec4 s0 = floor(b0)*2.0 + 1.0;
      vec4 s1 = floor(b1)*2.0 + 1.0;
      vec4 sh = -step(h, vec4(0.0));
      vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy ;
      vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww ;
      vec3 p0 = vec3(a0.xy,h.x);
      vec3 p1 = vec3(a0.zw,h.y);
      vec3 p2 = vec3(a1.xy,h.z);
      vec3 p3 = vec3(a1.zw,h.w);
      vec3 norm = taylorInvSqrt(vec3(dot(p0,p0), dot(p1,p1), dot(p2, p2)));
      p0 *= norm.x; p1 *= norm.y; p2 *= norm.z;
      vec4 norm2 = taylorInvSqrt(vec4(dot(p3,p3)));
      p3 *= norm2.x;
      vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
      m = m * m;
      return 42.0 * dot( m*m, vec4( dot(p0,x0), dot(p1,x1),
                                    dot(p2,x2), dot(p3,x3) ) );
    }

    void main() {
      // Morph noise over time
      vec3 noisePos = position * 0.95 + vec3(uMouse * 0.35, 0.0) + vec3(0.0, 0.0, uTime * 0.28);
      float noise = snoise(noisePos);
      vNoise = noise;

      // Displace geometry along surface normal
      vec3 displacedPos = position + normal * noise * 0.28;

      vec4 mvPosition = modelViewMatrix * vec4(displacedPos, 1.0);
      vNormal = normalize(normalMatrix * normal);
      vViewPosition = -mvPosition.xyz;

      gl_Position = projectionMatrix * mvPosition;
    }
  `;

  const fragmentShader = `
    uniform float uTime;
    uniform vec3 uPrimaryColor;
    uniform vec3 uAccentColor;
    varying vec3 vNormal;
    varying vec3 vViewPosition;
    varying float vNoise;

    void main() {
      vec3 normal = normalize(vNormal);
      vec3 viewDir = normalize(vViewPosition);

      // Fresnel calculation:bias + scale * (1.0 - max(dot(normal, viewDir), 0.0))^power
      float bias = 0.06;
      float scale = 1.35;
      float power = 3.0;
      float fresnel = bias + scale * pow(1.0 - max(dot(normal, viewDir), 0.0), power);

      vec3 baseColor = mix(uPrimaryColor, uAccentColor, fresnel + sin(uTime * 0.25) * 0.2);
      vec3 finalColor = baseColor * (fresnel * 2.0);

      gl_FragColor = vec4(finalColor, fresnel * 0.95);
    }
  `;

  const canvas = document.getElementById('hero-glass-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const parent = canvas.parentElement;
    if (!parent) throw new Error('Visual container missing');

    const width = parent.clientWidth;
    const height = parent.clientHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 100);
    camera.position.z = 4.2;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const uniforms = {
      uTime: { value: 0.0 },
      uMouse: { value: new THREE.Vector2(0, 0) },
      uPrimaryColor: { value: new THREE.Color() },
      uAccentColor: { value: new THREE.Color() }
    };

    const updateShaderColors = () => {
      const primaryStr = getComputedStyle(document.documentElement).getPropertyValue('--color-primary').trim() || '#ffffff';
      const accentStr = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() || '#dfc15d';
      uniforms.uPrimaryColor.value.set(primaryStr);
      uniforms.uAccentColor.value.set(accentStr);
    };
    updateShaderColors();
    window.addEventListener('yasio-theme-change', updateShaderColors);

    const material = new THREE.ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms,
      transparent: true,
      depthWrite: false,
      blending: THREE.NormalBlending
    });

    const geometry = new THREE.IcosahedronGeometry(1.25, 64);
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    // Cache parent bounding rect on load and window resize
    let r = parent.getBoundingClientRect();
    const handleResize = () => {
      const w = parent.clientWidth;
      const h = parent.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };
    
    const handleWindowResize = () => {
      r = parent.getBoundingClientRect();
      handleResize();
    };
    window.addEventListener('resize', handleWindowResize, { passive: true });

    // Smooth Mouse Easing
    let targetX = 0, targetY = 0;
    let currentX = 0, currentY = 0;

    window.addEventListener('mousemove', (e) => {
      // Map mouse position relative to the cached orb container
      targetX = ((e.clientX - r.left) / r.width) * 2 - 1;
      targetY = -((e.clientY - r.top) / r.height) * 2 + 1;
    }, { passive: true });

    parent.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
    });

    const clock = new THREE.Clock();
    let isVisible = true;
    let frameId: number;

    const animate = () => {
      if (!isVisible) return;

      const time = clock.getElapsedTime();
      material.uniforms.uTime.value = time;

      currentX += (targetX - currentX) * 0.05;
      currentY += (targetY - currentY) * 0.05;
      material.uniforms.uMouse.value.set(currentX, currentY);

      mesh.rotation.y = time * 0.09;
      mesh.rotation.x = time * 0.045;

      renderer.render(scene, camera);
      frameId = requestAnimationFrame(animate);
    };

    // IntersectionObserver to pause loop when orb container is out of viewport
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isVisible = entry.isIntersecting;
        if (isVisible) {
          clock.start();
          cancelAnimationFrame(frameId);
          animate();
        } else {
          clock.stop();
          cancelAnimationFrame(frameId);
        }
      });
    }, { threshold: 0.01 });

    const heroSection = document.getElementById('hero');
    if (heroSection) {
      observer.observe(heroSection);
    } else {
      animate(); // Fallback if section doesn't exist
    }
  }
</script>
