---

<div class="mt-16 sm:mt-20">
  <div class="text-center mb-10">
    <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text-muted)] tracking-widest uppercase text-sm">
      Core Stack
    </h3>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-5 sm:gap-8 md:gap-10">
    {techStack.map((tech) => (
      <div
        class="group relative flex flex-col items-center gap-2 transition-all duration-300 hover:-translate-y-2 cursor-default"
      >
        <div
          class="relative w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center rounded-2xl bg-[var(--glass-bg)] border border-[var(--color-border)] transition-all duration-300 overflow-hidden"
          style={`--tech-color: ${tech.color}`}
        >
          <!-- Hover glow bg -->
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
            style={`background: ${tech.color}15`}
          ></div>
          <!-- Icon -->
          <div
            class="relative z-10 w-7 h-7 sm:w-8 sm:h-8 transition-all duration-300"
            style={`color: ${tech.color}`}
            set:html={tech.svg}
          ></div>
          <!-- Border glow on hover -->
          <div
            class="absolute inset-0 rounded-2xl border opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            style={`border-color: ${tech.color}60`}
          ></div>
        </div>

        <!-- Name label: always visible on mobile, hover-only on desktop -->
        <span
          class="text-xs font-semibold text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-300 sm:opacity-0 sm:group-hover:opacity-100"
        >
          {tech.name}
        </span>

        <!-- Bottom glow -->
        <div
          class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-8 h-1 rounded-full blur-sm opacity-0 group-hover:opacity-70 transition-opacity duration-300"
          style={`background: ${tech.color}`}
        ></div>
      </div>
    ))}
  </div>

